// ---------------------------------------------------------------------------
// Direct operator panel — engine semantics stay under the hood
// ---------------------------------------------------------------------------
var table panel = table.new(position.bottom_right, 2, 9, bgcolor=color.new(color.black, 82), frame_color=color.new(color.gray, 55), frame_width=1, border_color=color.new(color.gray, 75))

if barstate.islast
    if showPanel
        bool awarenessTrend = exTrendOppStage != EX_OPP_STAGE_NONE and exTrendOppDir != 0
        bool awarenessRange = exRangeOppStage != EX_OPP_STAGE_NONE and exRangeOppDir != 0
        bool awarenessFrozen = exRelevantLocation and mapDir != 0

        string scenarioBaseTxt = exOperatorConflict ? "CONFLITO" :
             exRangeBoxValid and regimeDir == 0 ? "RANGE" :
             regimeStructureConflict ? "MISTO / CONFLITO" :
             regimeDir == 1 ? "ALTA" :
             regimeDir == -1 ? "BAIXA" :
             mapDir == 1 ? "TRANSIÇÃO ↑" :
             mapDir == -1 ? "TRANSIÇÃO ↓" : monthlyMacroOnly ? "MACRO / CICLO" : "TRANSIÇÃO"
        string macroScenarioSuffix = monthlyMacroContextEnabled ? (monthlyMacroAvailable ? (monthlyMacroDir == 1 ? " • MACRO ALTA" : monthlyMacroDir == -1 ? " • MACRO BAIXA" : " • MACRO NEUTRO") : " • MACRO —") : ""
        string scenarioTxt = scenarioBaseTxt + macroScenarioSuffix

        int awarenessDir = exOperatorDir != 0 ? exOperatorDir :
             awarenessTrend ? exTrendOppDir :
             awarenessRange ? exRangeOppDir :
             awarenessFrozen ? mapDir : 0

        string directOppTxt = exOperatorOppKind != EX_OPP_NONE ? f_ex_opp_txt(exOperatorOppKind) :
             awarenessTrend ? f_ex_opp_txt(exTrendOppKind) :
             awarenessRange ? "ROTAÇÃO DE RANGE" :
             awarenessFrozen ? (exLocation == EX_LOC_RETEST or exLocation == EX_LOC_RECLAIM ? "RETESTE / RECLAIM" : "CORREÇÃO") :
             "NENHUMA"

        string sideTxt = awarenessDir == 1 ? "COMPRA / LONG" : awarenessDir == -1 ? "VENDA / SHORT" : "—"

        string actionTxt = exOperatorReadiness != EX_OP_READY_WAIT ? f_ex_operator_txt(exOperatorReadiness, exOperatorDir) :
             (awarenessTrend or awarenessRange or awarenessFrozen) ? "OBSERVAR" : "AGUARDAR"
        if exAnticipatedPosture
            actionTxt := "ANTECIPADO • " + f_ex_operator_txt(exOperatorReadiness, exOperatorDir)

        float rangeDisplayTarget = awarenessRange and exRangeOppDir != 0 ? (exRangeOppDir == 1 ? exRangeOppHigh - exRangeOppEdge : exRangeOppLow + exRangeOppEdge) : na
        string targetTxt = not na(exManagementTarget) ? f_price(exManagementTarget) :
             not na(rangeDisplayTarget) ? f_price(rangeDisplayTarget) :
             activeDestinationTxt

        float rangeDisplayInvalidation = awarenessRange and exRangeOppDir != 0 ? (exRangeOppDir == 1 ? exRangeOppLow : exRangeOppHigh) : na
        string directInvalidTxt = not na(exManagementInvalidation) ? f_price(exManagementInvalidation) :
             not na(rangeDisplayInvalidation) ? f_price(rangeDisplayInvalidation) :
             thesisInvalidated ? "ROMPIDA • " + f_price(invalidation) :
             f_price(invalidation)

        string correctionTxt = correctionActive ? f_zone(primaryTop, primaryBottom) + "  " + f_stars(correctionConfluence) : ""

        color scenarioColor = scenarioTxt == "ALTA" or scenarioTxt == "TRANSIÇÃO ↑" ? color.lime :
             scenarioTxt == "BAIXA" or scenarioTxt == "TRANSIÇÃO ↓" ? color.red :
             scenarioTxt == "CONFLITO" or scenarioTxt == "MISTO / CONFLITO" ? color.orange :
             scenarioTxt == "RANGE" ? color.aqua : color.silver

        color sideColor = awarenessDir == 1 ? color.lime : awarenessDir == -1 ? color.red : color.silver
        color actionColor = exOperatorReadiness == EX_OP_READY_CONFLICT ? color.orange :
             exOperatorReadiness == EX_OP_READY_CONFIRMED ? (exOperatorDir == 1 ? color.lime : color.red) :
             exOperatorReadiness == EX_OP_READY_ARMED ? color.yellow :
             exOperatorReadiness == EX_OP_READY_PREP ? color.aqua :
             exOperatorReadiness == EX_OP_READY_ALIGNED ? (exOperatorDir == 1 ? color.lime : color.red) :
             (awarenessTrend or awarenessRange or awarenessFrozen) ? color.aqua : color.silver

        color managementColor = exManagementState == EX_MGMT_INVALIDATED ? color.red :
             exManagementState == EX_MGMT_AMBIGUOUS ? color.orange :
             exManagementState == EX_MGMT_REALIZATION_RISK ? color.orange :
             exManagementState == EX_MGMT_PROTECT ? color.yellow :
             exManagementState == EX_MGMT_COMPLETED ? color.lime :
             exManagementState == EX_MGMT_CONTINUATION ? color.aqua : color.silver

        table.cell(panel, 0, 0, "MARKET MAP", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 72))
        table.cell(panel, 1, 0, "v0.2 • " + responseProfile, text_color=color.silver, text_size=size.tiny, bgcolor=color.new(color.blue, 72))

        table.cell(panel, 0, 1, "CENÁRIO", text_color=color.silver, text_size=size.tiny)
        table.cell(panel, 1, 1, scenarioTxt, text_color=scenarioColor, text_size=size.small)

        table.cell(panel, 0, 2, "OPORTUNIDADE", text_color=color.silver, text_size=size.tiny)
        table.cell(panel, 1, 2, directOppTxt, text_color=directOppTxt == "NENHUMA" ? color.silver : color.aqua, text_size=size.small)

        table.cell(panel, 0, 3, "LADO", text_color=color.silver, text_size=size.tiny)
        table.cell(panel, 1, 3, sideTxt, text_color=sideColor, text_size=size.small)

        table.cell(panel, 0, 4, "AÇÃO", text_color=color.silver, text_size=size.tiny)
        table.cell(panel, 1, 4, actionTxt, text_color=actionColor, text_size=size.small)

        table.cell(panel, 0, 5, "ALVO", text_color=color.silver, text_size=size.tiny)
        table.cell(panel, 1, 5, targetTxt, text_color=color.aqua, text_size=size.small)

        table.cell(panel, 0, 6, "GESTÃO", text_color=color.silver, text_size=size.tiny)
        table.cell(panel, 1, 6, managementTxt, text_color=managementColor, text_size=size.small)

        table.cell(panel, 0, 7, "INVALIDA", text_color=color.silver, text_size=size.tiny)
        table.cell(panel, 1, 7, directInvalidTxt, text_color=color.red, text_size=size.small)

        table.cell(panel, 0, 8, correctionActive ? "CORREÇÃO" : "", text_color=color.silver, text_size=size.tiny)
        table.cell(panel, 1, 8, correctionTxt, text_color=color.yellow, text_size=size.small)
    else
        table.clear(panel, 0, 0, 1, 8)

