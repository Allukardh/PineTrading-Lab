//@version=6
indicator("Market Map v0.2.0", shorttitle="Market Map", overlay=true, max_bars_back=5000, max_boxes_count=50, max_lines_count=100, max_labels_count=100)

// ============================================================================
// Market Map 0.2.0 — MM-0 structural baseline + embedded Execution semantics
// Clean-room implementation for PineTrading-Lab.
// Purpose: trend/regime + confirmed structure + structural liquidity +
//          correction zones + concise map.
// ============================================================================

// ---------------------------------------------------------------------------
// Minimal operator controls
// ---------------------------------------------------------------------------
groupView = "Visual"
showMAs = input.bool(true, "Mostrar médias", group=groupView)
showPanel = input.bool(true, "Mostrar painel", group=groupView)

groupExecution = "Execução"
string responseProfile = input.string("PADRÃO", "Perfil de resposta", options=["PADRÃO", "ANTECIPADO"], group=groupExecution)

groupAdvanced = "Avançado / Diagnóstico"
showStructureDetails = input.bool(false, "Mostrar BOS/CHoCH e zonas secundárias", group=groupAdvanced)

// Engineering defaults are intentionally internal. They are product defaults,
// not operator tuning requirements.
int AUDIT_SCHEMA = 2
int FAST_LEN = 21
int MID_LEN = 50
int SLOW_LEN = 200
int ATR_LEN = 14
int PIVOT_LEN = 3
int POOL_MAX = 24
int RETEST_MAX_BARS = 24
int FAIL_MAX_BARS = 6
int PULLBACK_SAMPLE_MAX = 24
int PULLBACK_MIN_SAMPLES = 5
int ACCEPTANCE_BINS = 20
int ACCEPTANCE_MAX_BARS = 240
float EQ_TOL_ATR = 0.12
float RETEST_TOL_ATR = 0.18
float FAIL_TOL_ATR = 0.08
float INVALID_TOL_ATR = 0.12
float INVALID_WARN_ATR = 0.20
float TARGET_MERGE_ATR = 0.10
float TARGET_NEAR_ATR = 0.30
float PULLBACK_MIN_DEPTH = 0.12
float PULLBACK_MAX_DEPTH = 0.90

// Embedded Decision Panel Execution kernel — accepted defaults v2.
int EX_DEFAULTS_VERSION = 2
int EX_MTE_FAST_EMA = 8
int EX_MTE_SLOW_EMA = 21
int EX_MTE_ATR_LEN = 14
int EX_MTE_ACTIVITY_LEN = 20
float EX_MTE_NEUTRAL_FACTOR = 0.15
float EX_MTE_TURN_FACTOR = 0.50
float EX_MTE_TURN_FLOOR = 0.02
float EX_MTE_ACCEL_EPS = 1e-9

int EX_RSI_LEN = 14
float EX_RSI_CENTER_LOW = 48.0
float EX_RSI_CENTER_HIGH = 52.0
float EX_RSI_OVERBOUGHT = 70.0
float EX_RSI_OVERSOLD = 30.0
float EX_RSI_EXTREME_OVERBOUGHT_LEVEL = 80.0
float EX_RSI_EXTREME_OVERSOLD_LEVEL = 20.0
float EX_RSI_MIN_STEP = 0.25
int EX_RSI_ZONE_MEMORY_BARS = 2

int EX_PSE_VOLUME_EMA_LEN = 20
float EX_PSE_CONTRACTED_BELOW = 0.80
float EX_PSE_EXPANDED_AT_OR_ABOVE = 1.20
float EX_PSE_PRESSURE_MIN = 0.20

float EX_APPROACH_ATR = 0.50
int EX_EVENT_HOLD_BARS = 3
int EX_EVENT_HOLD_MAX_MS = 12 * 60 * 60 * 1000

int EX_LOC_OUTSIDE = 0
int EX_LOC_APPROACHING = 1
int EX_LOC_IN_CORRECTION = 2
int EX_LOC_RETEST = 3
int EX_LOC_RECLAIM = 4
int EX_LOC_DESTINATION_NEAR = 5

int EX_MTE_NEUTRAL = 0
int EX_MTE_TURN_UP = 1
int EX_MTE_UP_ACCEL = 2
int EX_MTE_UP_DECEL = 3
int EX_MTE_TURN_DOWN = -1
int EX_MTE_DOWN_ACCEL = -2
int EX_MTE_DOWN_DECEL = -3

int EX_RSI_NEUTRAL = 0
int EX_RSI_BULL = 1
int EX_RSI_RECOVERING_OVERSOLD = 2
int EX_RSI_RECOVERING_OVERBOUGHT = 3
int EX_RSI_EXTREME_OVERBOUGHT = 4
int EX_RSI_EXTREME_OVERSOLD = -4
int EX_RSI_FADING_OVERSOLD = -3
int EX_RSI_FADING_OVERBOUGHT = -2
int EX_RSI_BEAR = -1

int EX_PSE_NEUTRAL = 0
int EX_PSE_CONFIRM = 1
int EX_PSE_WEAK = 2
int EX_PSE_CONTRARY = -1

int EX_READY_WAIT = 0
int EX_READY_PREP = 1
int EX_READY_ARMED = 2
int EX_READY_CONFIRMED = 3
int EX_READY_ALIGNED = 4

int EX_STRENGTH_NORMAL = 0
int EX_STRENGTH_FADING = 1
int EX_STRENGTH_EXHAUSTED = 2
int EX_STRENGTH_REACTION_RISK = 3

// Suite 0.2 Opportunity / operator / management codes.
int EX_OPP_NONE = 0
int EX_OPP_BREAKOUT_EXPANSION = 1
int EX_OPP_REACCELERATION = 2
int EX_OPP_REGIME_REVERSAL = 3
int EX_OPP_RANGE_ROTATION = 4

int EX_OPP_STAGE_NONE = 0
int EX_OPP_STAGE_CANDIDATE = 1
int EX_OPP_STAGE_STRONG = 2
int EX_OPP_STAGE_ACCEPTED = 3

int EX_OP_READY_WAIT = 0
int EX_OP_READY_PREP = 1
int EX_OP_READY_ARMED = 2
int EX_OP_READY_CONFIRMED = 3
int EX_OP_READY_ALIGNED = 4
int EX_OP_READY_CONFLICT = 5

int EX_PATH_NONE = 0
int EX_PATH_FROZEN_0_1 = 1
int EX_PATH_TREND_V2 = 2
int EX_PATH_RANGE_ANY1 = 3
int EX_PATH_MULTI = 4

int EX_BREAK_OTHER = 0
int EX_BREAK_EARLY_TRANSITION = 1
int EX_BREAK_FRESH_EXPANSION = 2
int EX_BREAK_PULLBACK_RESOLUTION = 3
int EX_BREAK_REACCELERATION = 4

int EX_REVERSAL_PRIOR_REGIME_MIN_BARS = 8
int EX_REACCELERATION_REGIME_MIN_BARS = 8
float EX_BREAK_DECISIVE_ATR = 0.50

float EX_RANGE_BOUNDARY_DRIFT_MAX = 0.20
float EX_RANGE_MIN_HEIGHT_ATR = 2.0
float EX_RANGE_EDGE_FRACTION = 0.20

int EX_MGMT_NONE = 0
int EX_MGMT_CONTINUATION = 1
int EX_MGMT_PROTECT = 2
int EX_MGMT_REALIZATION_RISK = 3
int EX_MGMT_COMPLETED = 4
int EX_MGMT_INVALIDATED = 5
int EX_MGMT_AMBIGUOUS = 6

int EX_CAP_NONE = 0
int EX_CAP_TARGET_ONLY = 1
int EX_CAP_INVALIDATION_ONLY = 2
int EX_CAP_FULL = 3

float EX_MGMT_TARGET_NEAR_ATR = 0.30
float EX_MGMT_INVALID_WARN_ATR = 0.20

bool detailed = showStructureDetails

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
f_sec(_tf, _expr) =>
    _reqSec = timeframe.in_seconds(_tf)
    _chartSec = timeframe.in_seconds()
    _reqSec > _chartSec ? request.security(syminfo.tickerid, _tf, _expr[1], barmerge.gaps_off, barmerge.lookahead_on) : _expr

f_price(_v) =>
    na(_v) ? "—" : str.tostring(_v, format.mintick)

f_zone(_top, _bottom) =>
    na(_top) or na(_bottom) ? "—" : str.tostring(_bottom, format.mintick) + " – " + str.tostring(_top, format.mintick)

f_stars(_n) =>
    _n >= 5 ? "★★★★★" :
     _n == 4 ? "★★★★" :
     _n == 3 ? "★★★" :
     _n == 2 ? "★★" :
     _n == 1 ? "★" : "—"

f_in_zone(_v, _top, _bottom, _tol) =>
    not na(_v) and not na(_top) and not na(_bottom) and _v <= _top + _tol and _v >= _bottom - _tol

f_trim_pool(_levels, _swept, _strength, _bars) =>
    if array.size(_levels) > POOL_MAX
        array.shift(_levels)
        array.shift(_swept)
        array.shift(_strength)
        array.shift(_bars)

f_push_pullback(_arr, _depth) =>
    if not na(_depth) and _depth >= PULLBACK_MIN_DEPTH and _depth <= PULLBACK_MAX_DEPTH
        array.push(_arr, _depth)
        if array.size(_arr) > PULLBACK_SAMPLE_MAX
            array.shift(_arr)

f_quantile(_arr, _q) =>
    float result = na
    int n = array.size(_arr)
    if n > 0
        float[] copy = array.copy(_arr)
        array.sort(copy, order.ascending)
        float pos = (n - 1) * _q
        int lo = int(math.floor(pos))
        int hi = int(math.ceil(pos))
        float loV = array.get(copy, lo)
        float hiV = array.get(copy, hi)
        result := lo == hi ? loV : loV + (hiV - loV) * (pos - lo)
    result

f_ex_seeded_ema(_src, _length) =>
    float alpha = 2.0 / (_length + 1.0)
    float seed = ta.sma(_src, _length)
    float value = na
    value := na(value[1]) ? seed : alpha * _src + (1.0 - alpha) * value[1]
    value

f_ex_seeded_rma(_src, _length) =>
    float alpha = 1.0 / _length
    float seed = ta.sma(_src, _length)
    float value = na
    value := na(value[1]) ? seed : alpha * _src + (1.0 - alpha) * value[1]
    value

f_ex_rsi(_src) =>
    float change = _src - _src[1]
    float gain = na(change) ? na : math.max(change, 0.0)
    float loss = na(change) ? na : math.max(-change, 0.0)
    float avgGain = f_ex_seeded_rma(gain, EX_RSI_LEN)
    float avgLoss = f_ex_seeded_rma(loss, EX_RSI_LEN)
    float result = na
    if not na(avgGain) and not na(avgLoss)
        result := avgGain == 0.0 and avgLoss == 0.0 ? 50.0 :
             avgLoss == 0.0 ? 100.0 :
             avgGain == 0.0 ? 0.0 :
             100.0 - 100.0 / (1.0 + avgGain / avgLoss)
    result

f_ex_readiness_txt(_stage, _dir) =>
    _stage == EX_READY_PREP ? (_dir == 1 ? "PREPARANDO LONG" : _dir == -1 ? "PREPARANDO SHORT" : "AGUARDAR") :
     _stage == EX_READY_ARMED ? (_dir == 1 ? "ARMADO LONG" : _dir == -1 ? "ARMADO SHORT" : "AGUARDAR") :
     _stage == EX_READY_CONFIRMED ? (_dir == 1 ? "CONFIRMA LONG" : _dir == -1 ? "CONFIRMA SHORT" : "AGUARDAR") :
     _stage == EX_READY_ALIGNED ? (_dir == 1 ? "ALINHADO LONG" : _dir == -1 ? "ALINHADO SHORT" : "AGUARDAR") :
     "AGUARDAR"

f_ex_strength_txt(_state) =>
    _state == EX_STRENGTH_FADING ? "PERDENDO FORÇA" :
     _state == EX_STRENGTH_EXHAUSTED ? "EXAUSTÃO" :
     _state == EX_STRENGTH_REACTION_RISK ? "RISCO DE REAÇÃO" :
     "NORMAL"

f_ex_momentum_aligned_dir(_dir, _state) =>
    _dir == 1 ? (_state == EX_MTE_TURN_UP or _state == EX_MTE_UP_ACCEL) :
     _dir == -1 ? (_state == EX_MTE_TURN_DOWN or _state == EX_MTE_DOWN_ACCEL) : false

f_ex_momentum_opposes_dir(_dir, _state) =>
    _dir == 1 ? (_state == EX_MTE_TURN_DOWN or _state == EX_MTE_DOWN_ACCEL) :
     _dir == -1 ? (_state == EX_MTE_TURN_UP or _state == EX_MTE_UP_ACCEL) : true

f_ex_rsi_local_supports_dir(_dir, _state) =>
    _dir == 1 ? (_state == EX_RSI_BULL or _state == EX_RSI_RECOVERING_OVERSOLD or _state == EX_RSI_RECOVERING_OVERBOUGHT) :
     _dir == -1 ? (_state == EX_RSI_BEAR or _state == EX_RSI_FADING_OVERBOUGHT or _state == EX_RSI_FADING_OVERSOLD) : false

f_ex_rsi_local_opposes_dir(_dir, _state) =>
    _dir == 1 ? (_state == EX_RSI_BEAR or _state == EX_RSI_FADING_OVERBOUGHT or _state == EX_RSI_EXTREME_OVERBOUGHT) :
     _dir == -1 ? (_state == EX_RSI_BULL or _state == EX_RSI_RECOVERING_OVERSOLD or _state == EX_RSI_EXTREME_OVERSOLD) : true

f_ex_rsi_supports_dir(_dir, _state, _ctx) =>
    f_ex_rsi_local_supports_dir(_dir, _state) and _ctx != -_dir

f_ex_rsi_opposes_dir(_dir, _state, _ctx) =>
    f_ex_rsi_local_opposes_dir(_dir, _state) or (_dir != 0 and _ctx == -_dir)

f_ex_pse_state_dir(_dir, _ready, _relVolume, _pressure) =>
    int result = EX_PSE_NEUTRAL
    if _ready and _dir != 0
        float directional = _pressure * _dir
        result := _relVolume < EX_PSE_CONTRACTED_BELOW ? EX_PSE_WEAK :
             _relVolume >= EX_PSE_EXPANDED_AT_OR_ABOVE and directional >= EX_PSE_PRESSURE_MIN ? EX_PSE_CONFIRM :
             _relVolume >= EX_PSE_EXPANDED_AT_OR_ABOVE and directional <= -EX_PSE_PRESSURE_MIN ? EX_PSE_CONTRARY :
             EX_PSE_NEUTRAL
    result

f_ex_ready_urgency(_ready) =>
    _ready == EX_READY_CONFIRMED ? 4 :
     _ready == EX_READY_ARMED ? 3 :
     _ready == EX_READY_PREP ? 2 :
     _ready == EX_READY_ALIGNED ? 1 : 0

f_ex_operator_txt(_stage, _dir) =>
    _stage == EX_OP_READY_CONFLICT ? "CONFLITO" :
     _stage == EX_OP_READY_PREP ? (_dir == 1 ? "PREPARANDO LONG" : _dir == -1 ? "PREPARANDO SHORT" : "AGUARDAR") :
     _stage == EX_OP_READY_ARMED ? (_dir == 1 ? "ARMADO LONG" : _dir == -1 ? "ARMADO SHORT" : "AGUARDAR") :
     _stage == EX_OP_READY_CONFIRMED ? (_dir == 1 ? "CONFIRMA LONG" : _dir == -1 ? "CONFIRMA SHORT" : "AGUARDAR") :
     _stage == EX_OP_READY_ALIGNED ? (_dir == 1 ? "ALINHADO LONG" : _dir == -1 ? "ALINHADO SHORT" : "AGUARDAR") :
     "AGUARDAR"

f_ex_opp_txt(_kind) =>
    _kind == EX_OPP_BREAKOUT_EXPANSION ? "BREAKOUT" :
     _kind == EX_OPP_REACCELERATION ? "REACELERAÇÃO" :
     _kind == EX_OPP_REGIME_REVERSAL ? "REVERSÃO" :
     _kind == EX_OPP_RANGE_ROTATION ? "ROTAÇÃO DE RANGE" :
     "—"

f_ex_momentum_deteriorates_dir(_dir, _state) =>
    _dir == 1 ? (_state == EX_MTE_UP_DECEL or _state == EX_MTE_TURN_DOWN or _state == EX_MTE_DOWN_ACCEL or _state == EX_MTE_DOWN_DECEL) :
     _dir == -1 ? (_state == EX_MTE_DOWN_DECEL or _state == EX_MTE_TURN_UP or _state == EX_MTE_UP_ACCEL or _state == EX_MTE_UP_DECEL) : false

f_ex_rsi_deteriorates_dir(_dir, _state) =>
    _dir == 1 ? (_state == EX_RSI_FADING_OVERBOUGHT or _state == EX_RSI_EXTREME_OVERBOUGHT) :
     _dir == -1 ? (_state == EX_RSI_RECOVERING_OVERSOLD or _state == EX_RSI_EXTREME_OVERSOLD) : false

f_ex_strength_for_dir(_dir, _destinationNear, _mte, _rsi, _pse) =>
    int generic = (f_ex_momentum_deteriorates_dir(_dir, _mte) ? 1 : 0) + (f_ex_rsi_deteriorates_dir(_dir, _rsi) ? 1 : 0) + (_pse == EX_PSE_CONTRARY ? 1 : 0)
    int destination = (f_ex_momentum_deteriorates_dir(_dir, _mte) ? 1 : 0) + (f_ex_rsi_deteriorates_dir(_dir, _rsi) ? 1 : 0) + ((_pse == EX_PSE_WEAK or _pse == EX_PSE_CONTRARY) ? 1 : 0)
    _destinationNear and destination >= 2 ? EX_STRENGTH_REACTION_RISK :
     generic >= 2 ? EX_STRENGTH_EXHAUSTED :
     generic == 1 ? EX_STRENGTH_FADING : EX_STRENGTH_NORMAL

f_ex_same_level(_a, _b) =>
    float tol = 1e-9 * math.max(1.0, math.max(math.abs(_a), math.abs(_b)))
    math.abs(_a - _b) <= tol

f_ex_target_usable(_dir, _confirmClose, _target) =>
    not na(_target) and _dir != 0 and _dir * (_target - _confirmClose) > 0

f_ex_invalidation_usable(_dir, _confirmClose, _invalidation) =>
    not na(_invalidation) and _dir != 0 and _dir * (_confirmClose - _invalidation) > 0

f_ex_management_txt(_state) =>
    _state == EX_MGMT_CONTINUATION ? "CONTINUIDADE" :
     _state == EX_MGMT_PROTECT ? "PROTEGER" :
     _state == EX_MGMT_REALIZATION_RISK ? "REALIZAÇÃO" :
     _state == EX_MGMT_COMPLETED ? "CONCLUÍDA" :
     _state == EX_MGMT_INVALIDATED ? "INVALIDADA" :
     _state == EX_MGMT_AMBIGUOUS ? "AMBÍGUA" :
     "—"

f_impulse_acceptance(_startBar, _endBar, _low, _high) =>
    float vwapValue = na
    float volumeNode = na
    int matchedBars = 0
    float impulseSpan = _high - _low
    if not na(_startBar) and not na(_endBar) and impulseSpan > syminfo.mintick
        float totalPV = 0.0
        float totalV = 0.0
        float[] bins = array.new_float(ACCEPTANCE_BINS, 0.0)
        for ago = 0 to ACCEPTANCE_MAX_BARS - 1
            int sourceBar = bar_index - ago
            if sourceBar >= _startBar and sourceBar <= _endBar
                float v = nz(volume[ago], 0.0)
                float p = hlc3[ago]
                if v > 0 and not na(p)
                    totalPV += p * v
                    totalV += v
                    matchedBars += 1
                    float rel = math.max(0.0, math.min(0.999999, (p - _low) / impulseSpan))
                    int bin = int(math.floor(rel * ACCEPTANCE_BINS))
                    array.set(bins, bin, array.get(bins, bin) + v)
        if totalV > 0
            vwapValue := totalPV / totalV
            float maxBinV = array.max(bins)
            int nodeBin = array.indexof(bins, maxBinV)
            volumeNode := _low + (nodeBin + 0.5) * (impulseSpan / ACCEPTANCE_BINS)
    [vwapValue, volumeNode, matchedBars]

// ---------------------------------------------------------------------------
// Timeframe context — automatic, deterministic, confirmed HTF
// ---------------------------------------------------------------------------
float chartSec = timeframe.in_seconds()
float tf15Sec = timeframe.in_seconds("15")
float tf60Sec = timeframe.in_seconds("60")
float tf240Sec = timeframe.in_seconds("240")
float tfDSec = timeframe.in_seconds("D")
float tfWSec = timeframe.in_seconds("W")

if na(chartSec)
    runtime.error("Market Map requires a time-based chart timeframe.")

string contextTf = chartSec <= tf15Sec ? "60" :
     chartSec <= tf60Sec ? "240" :
     chartSec <= tf240Sec ? "D" :
     chartSec <= tfDSec ? "W" :
     timeframe.period

// High-horizon macro context: prior completed calendar month only.
// It is descriptive context and never a hard execution filter.
bool monthlyMacroOnly = timeframe.ismonthly
bool monthlyMacroContextEnabled = timeframe.period == "3D" or timeframe.period == "W"
float monthlyMacroRaw = monthlyMacroContextEnabled ? f_sec("M",
     ta.ema(close, MID_LEN) > ta.ema(close, SLOW_LEN) and ta.ema(close, SLOW_LEN) >= ta.ema(close, SLOW_LEN)[3] and close > ta.ema(close, SLOW_LEN) ? 1.0 :
     ta.ema(close, MID_LEN) < ta.ema(close, SLOW_LEN) and ta.ema(close, SLOW_LEN) <= ta.ema(close, SLOW_LEN)[3] and close < ta.ema(close, SLOW_LEN) ? -1.0 : 0.0) : na
bool monthlyMacroAvailable = monthlyMacroContextEnabled and not na(monthlyMacroRaw)
int monthlyMacroDir = monthlyMacroAvailable ? int(monthlyMacroRaw) : 0

// ---------------------------------------------------------------------------
// Trend / regime layer
// ---------------------------------------------------------------------------
float emaFast = ta.ema(close, FAST_LEN)
float emaMid = ta.ema(close, MID_LEN)
float emaSlow = ta.ema(close, SLOW_LEN)
float atr = ta.atr(ATR_LEN)

float ctxClose = f_sec(contextTf, close)
float ctxMid = f_sec(contextTf, ta.ema(close, MID_LEN))
float ctxSlow = f_sec(contextTf, ta.ema(close, SLOW_LEN))

// Regime is deliberately slower than execution. A normal pullback below the
// fast/mid layer should not erase a higher-timeframe bullish/bearish regime.
bool localBullRegime = emaMid > emaSlow and emaSlow >= emaSlow[3]
bool localBearRegime = emaMid < emaSlow and emaSlow <= emaSlow[3]
bool ctxBullRegime = ctxMid > ctxSlow and ctxClose > ctxSlow
bool ctxBearRegime = ctxMid < ctxSlow and ctxClose < ctxSlow

int regimeDir = localBullRegime and ctxBullRegime ? 1 : localBearRegime and ctxBearRegime ? -1 : 0
string regimeTxt = regimeDir == 1 ? "ALTA" : regimeDir == -1 ? "BAIXA" : "NEUTRO / TRANSIÇÃO"

// ---------------------------------------------------------------------------
// Confirmed swing structure
// ---------------------------------------------------------------------------
float ph = ta.pivothigh(high, PIVOT_LEN, PIVOT_LEN)
float pl = ta.pivotlow(low, PIVOT_LEN, PIVOT_LEN)
bool newPH = not na(ph)
bool newPL = not na(pl)

// Evaluate rolling post-pivot windows every bar; used to reconstruct whether a
// newly confirmed pivot was already swept during its confirmation delay.
float postPivotHigh = ta.highest(high, PIVOT_LEN)
float postPivotLow = ta.lowest(low, PIVOT_LEN)

var float lastSwingHigh = na
var float prevSwingHigh = na
var int lastSwingHighBar = na
var int prevSwingHighBar = na
var string lastHighType = "—"

var float lastSwingLow = na
var float prevSwingLow = na
var int lastSwingLowBar = na
var int prevSwingLowBar = na
var string lastLowType = "—"

bool eqHighNow = newPH and not na(lastSwingHigh) and math.abs(ph - lastSwingHigh) <= atr * EQ_TOL_ATR
bool eqLowNow = newPL and not na(lastSwingLow) and math.abs(pl - lastSwingLow) <= atr * EQ_TOL_ATR

// Structural-liquidity pool store.
var float[] highPools = array.new_float()
var bool[] highSwept = array.new_bool()
var int[] highStrength = array.new_int()
var int[] highBars = array.new_int()

var float[] lowPools = array.new_float()
var bool[] lowSwept = array.new_bool()
var int[] lowStrength = array.new_int()
var int[] lowBars = array.new_int()

// Completed structural pullbacks become empirical depth samples.
// Samples are recorded before the current pivot replaces the previous swing state.
var float[] bullPullbacks = array.new_float()
var float[] bearPullbacks = array.new_float()

int candidatePivotBar = bar_index - PIVOT_LEN
float bullPullbackDepth = na
float bearPullbackDepth = na

if newPL and lastHighType == "HH" and not na(lastSwingLowBar) and not na(lastSwingHighBar) and lastSwingLowBar < lastSwingHighBar and lastSwingHighBar < candidatePivotBar
    float priorBullRange = lastSwingHigh - lastSwingLow
    bullPullbackDepth := priorBullRange > syminfo.mintick ? (lastSwingHigh - pl) / priorBullRange : na

if newPH and lastLowType == "LL" and not na(lastSwingHighBar) and not na(lastSwingLowBar) and lastSwingHighBar < lastSwingLowBar and lastSwingLowBar < candidatePivotBar
    float priorBearRange = lastSwingHigh - lastSwingLow
    bearPullbackDepth := priorBearRange > syminfo.mintick ? (ph - lastSwingLow) / priorBearRange : na

f_push_pullback(bullPullbacks, bullPullbackDepth)
f_push_pullback(bearPullbacks, bearPullbackDepth)

if newPH
    prevSwingHigh := lastSwingHigh
    prevSwingHighBar := lastSwingHighBar
    lastSwingHigh := ph
    lastSwingHighBar := bar_index - PIVOT_LEN
    lastHighType := na(prevSwingHigh) ? "H" : ph > prevSwingHigh ? "HH" : "LH"

    bool alreadySwept = postPivotHigh > ph + syminfo.mintick
    int strength = eqHighNow ? 2 : 1
    array.push(highPools, ph)
    array.push(highSwept, alreadySwept)
    array.push(highStrength, strength)
    array.push(highBars, lastSwingHighBar)
    f_trim_pool(highPools, highSwept, highStrength, highBars)

if newPL
    prevSwingLow := lastSwingLow
    prevSwingLowBar := lastSwingLowBar
    lastSwingLow := pl
    lastSwingLowBar := bar_index - PIVOT_LEN
    lastLowType := na(prevSwingLow) ? "L" : pl > prevSwingLow ? "HL" : "LL"

    bool alreadySwept = postPivotLow < pl - syminfo.mintick
    int strength = eqLowNow ? 2 : 1
    array.push(lowPools, pl)
    array.push(lowSwept, alreadySwept)
    array.push(lowStrength, strength)
    array.push(lowBars, lastSwingLowBar)
    f_trim_pool(lowPools, lowSwept, lowStrength, lowBars)

// Mark confirmed sweeps and retain the nearest same-bar reclaim event before
// the consumed pool disappears from the unswept-liquidity map.
float reclaimAboveLevel = na
string reclaimAboveSource = "—"
float reclaimBelowLevel = na
string reclaimBelowSource = "—"

if barstate.isconfirmed
    int highCount = array.size(highPools)
    if highCount > 0
        for i = 0 to highCount - 1
            float level = array.get(highPools, i)
            bool wasSwept = array.get(highSwept, i)
            if not wasSwept and high > level + syminfo.mintick
                if close < level and (na(reclaimAboveLevel) or level < reclaimAboveLevel)
                    reclaimAboveLevel := level
                    reclaimAboveSource := array.get(highStrength, i) >= 2 ? "EQH" : "SWING"
                array.set(highSwept, i, true)

    int lowCount = array.size(lowPools)
    if lowCount > 0
        for i = 0 to lowCount - 1
            float level = array.get(lowPools, i)
            bool wasSwept = array.get(lowSwept, i)
            if not wasSwept and low < level - syminfo.mintick
                if close > level and (na(reclaimBelowLevel) or level > reclaimBelowLevel)
                    reclaimBelowLevel := level
                    reclaimBelowSource := array.get(lowStrength, i) >= 2 ? "EQL" : "SWING"
                array.set(lowSwept, i, true)

// Structure break calculations are evaluated every bar and committed on close.
bool crossSwingHigh = ta.crossover(close, lastSwingHigh)
bool crossSwingLow = ta.crossunder(close, lastSwingLow)
bool breakUp = barstate.isconfirmed and not na(lastSwingHigh) and crossSwingHigh
bool breakDown = barstate.isconfirmed and not na(lastSwingLow) and crossSwingLow

var int structureDir = 0
bool chochUp = breakUp and structureDir < 0
bool chochDown = breakDown and structureDir > 0
bool bosUp = breakUp and not chochUp
bool bosDown = breakDown and not chochDown

var float lastBreakLevel = na
var int lastBreakDir = 0
var int lastBreakBar = na
var int preBreakStructureDir = 0

// A breakout starts a developing impulse immediately. This lets Market Map
// project pullback zones before the terminal pivot is confirmed. The LIVE
// label explicitly tells the operator that the extreme can still expand.
var int liveImpulseDir = 0
var float liveImpulseLow = na
var float liveImpulseHigh = na
var int liveImpulseStartBar = na
var int liveImpulseBreakBar = na

if breakUp
    preBreakStructureDir := structureDir
    structureDir := 1
    lastBreakLevel := lastSwingHigh
    lastBreakDir := 1
    lastBreakBar := bar_index

    liveImpulseDir := 1
    liveImpulseLow := lastSwingLow
    liveImpulseHigh := high
    liveImpulseStartBar := lastSwingLowBar
    liveImpulseBreakBar := bar_index

if breakDown
    preBreakStructureDir := structureDir
    structureDir := -1
    lastBreakLevel := lastSwingLow
    lastBreakDir := -1
    lastBreakBar := bar_index

    liveImpulseDir := -1
    liveImpulseHigh := lastSwingHigh
    liveImpulseLow := low
    liveImpulseStartBar := lastSwingHighBar
    liveImpulseBreakBar := bar_index

if liveImpulseDir == 1 and not na(liveImpulseHigh)
    liveImpulseHigh := math.max(liveImpulseHigh, high)

if liveImpulseDir == -1 and not na(liveImpulseLow)
    liveImpulseLow := math.min(liveImpulseLow, low)

bool retestUp = barstate.isconfirmed and lastBreakDir == 1 and not na(lastBreakBar) and bar_index > lastBreakBar and bar_index - lastBreakBar <= RETEST_MAX_BARS and low <= lastBreakLevel + atr * RETEST_TOL_ATR and close >= lastBreakLevel
bool retestDown = barstate.isconfirmed and lastBreakDir == -1 and not na(lastBreakBar) and bar_index > lastBreakBar and bar_index - lastBreakBar <= RETEST_MAX_BARS and high >= lastBreakLevel - atr * RETEST_TOL_ATR and close <= lastBreakLevel

bool failedBreakUp = barstate.isconfirmed and lastBreakDir == 1 and not na(lastBreakBar) and bar_index > lastBreakBar and bar_index - lastBreakBar <= FAIL_MAX_BARS and close < lastBreakLevel - atr * FAIL_TOL_ATR
bool failedBreakDown = barstate.isconfirmed and lastBreakDir == -1 and not na(lastBreakBar) and bar_index > lastBreakBar and bar_index - lastBreakBar <= FAIL_MAX_BARS and close > lastBreakLevel + atr * FAIL_TOL_ATR
bool fakeoutUpEvt = failedBreakUp
bool fakeoutDownEvt = failedBreakDown

if fakeoutUpEvt or fakeoutDownEvt
    structureDir := preBreakStructureDir
    lastBreakDir := 0
    liveImpulseDir := 0

string swingStructureTxt = lastHighType + "/" + lastLowType
bool bullSwingSequence = lastHighType == "HH" and lastLowType == "HL"
bool bearSwingSequence = lastHighType == "LH" and lastLowType == "LL"

string structureTxt = structureDir == 1 ?
     (bullSwingSequence ? "ALTA • HH/HL" : bearSwingSequence ? "ALTA • REVERSÃO" : "ALTA • MISTA") :
     structureDir == -1 ?
     (bearSwingSequence ? "BAIXA • LH/LL" : bullSwingSequence ? "BAIXA • REVERSÃO" : "BAIXA • MISTA") :
     swingStructureTxt

// ---------------------------------------------------------------------------
// Confirmed external liquidity references
// ---------------------------------------------------------------------------
bool dayLevelsAllowed = chartSec <= tfDSec
bool weekLevelsAllowed = chartSec <= tfWSec

float prevDayHigh = dayLevelsAllowed ? request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_on) : na
float prevDayLow = dayLevelsAllowed ? request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_on) : na
float prevWeekHigh = weekLevelsAllowed ? request.security(syminfo.tickerid, "W", high[1], barmerge.gaps_off, barmerge.lookahead_on) : na
float prevWeekLow = weekLevelsAllowed ? request.security(syminfo.tickerid, "W", low[1], barmerge.gaps_off, barmerge.lookahead_on) : na

bool newDay = ta.change(time("D")) != 0
bool newWeek = ta.change(time("W")) != 0

var bool pdhSwept = false
var bool pdlSwept = false
var bool pwhSwept = false
var bool pwlSwept = false

if newDay
    pdhSwept := false
    pdlSwept := false

if newWeek
    pwhSwept := false
    pwlSwept := false

if barstate.isconfirmed
    if dayLevelsAllowed and not pdhSwept and not na(prevDayHigh) and high > prevDayHigh + syminfo.mintick
        if close < prevDayHigh and (na(reclaimAboveLevel) or prevDayHigh < reclaimAboveLevel)
            reclaimAboveLevel := prevDayHigh
            reclaimAboveSource := "PDH"
        pdhSwept := true
    if dayLevelsAllowed and not pdlSwept and not na(prevDayLow) and low < prevDayLow - syminfo.mintick
        if close > prevDayLow and (na(reclaimBelowLevel) or prevDayLow > reclaimBelowLevel)
            reclaimBelowLevel := prevDayLow
            reclaimBelowSource := "PDL"
        pdlSwept := true
    if weekLevelsAllowed and not pwhSwept and not na(prevWeekHigh) and high > prevWeekHigh + syminfo.mintick
        if close < prevWeekHigh and (na(reclaimAboveLevel) or prevWeekHigh < reclaimAboveLevel)
            reclaimAboveLevel := prevWeekHigh
            reclaimAboveSource := "PWH"
        pwhSwept := true
    if weekLevelsAllowed and not pwlSwept and not na(prevWeekLow) and low < prevWeekLow - syminfo.mintick
        if close > prevWeekLow and (na(reclaimBelowLevel) or prevWeekLow > reclaimBelowLevel)
            reclaimBelowLevel := prevWeekLow
            reclaimBelowSource := "PWL"
        pwlSwept := true

// ---------------------------------------------------------------------------
// Nearest unswept structural liquidity
// ---------------------------------------------------------------------------
float liqAbove = na
int liqAboveStrength = 0
int liqAboveBar = na
string liqAboveSource = "—"
int hc = array.size(highPools)
if hc > 0
    for i = 0 to hc - 1
        float level = array.get(highPools, i)
        bool swept = array.get(highSwept, i)
        if not swept and level > close
            if na(liqAbove) or level < liqAbove
                liqAbove := level
                liqAboveStrength := array.get(highStrength, i)
                liqAboveBar := array.get(highBars, i)
                liqAboveSource := liqAboveStrength >= 2 ? "EQH" : "SWING"

if dayLevelsAllowed and not pdhSwept and not na(prevDayHigh) and prevDayHigh > close and (na(liqAbove) or prevDayHigh < liqAbove)
    liqAbove := prevDayHigh
    liqAboveStrength := 2
    liqAboveBar := bar_index
    liqAboveSource := "PDH"

if weekLevelsAllowed and not pwhSwept and not na(prevWeekHigh) and prevWeekHigh > close and (na(liqAbove) or prevWeekHigh < liqAbove)
    liqAbove := prevWeekHigh
    liqAboveStrength := 3
    liqAboveBar := bar_index
    liqAboveSource := "PWH"

float liqBelow = na
int liqBelowStrength = 0
int liqBelowBar = na
string liqBelowSource = "—"
int lc = array.size(lowPools)
if lc > 0
    for i = 0 to lc - 1
        float level = array.get(lowPools, i)
        bool swept = array.get(lowSwept, i)
        if not swept and level < close
            if na(liqBelow) or level > liqBelow
                liqBelow := level
                liqBelowStrength := array.get(lowStrength, i)
                liqBelowBar := array.get(lowBars, i)
                liqBelowSource := liqBelowStrength >= 2 ? "EQL" : "SWING"

if dayLevelsAllowed and not pdlSwept and not na(prevDayLow) and prevDayLow < close and (na(liqBelow) or prevDayLow > liqBelow)
    liqBelow := prevDayLow
    liqBelowStrength := 2
    liqBelowBar := bar_index
    liqBelowSource := "PDL"

if weekLevelsAllowed and not pwlSwept and not na(prevWeekLow) and prevWeekLow < close and (na(liqBelow) or prevWeekLow > liqBelow)
    liqBelow := prevWeekLow
    liqBelowStrength := 3
    liqBelowBar := bar_index
    liqBelowSource := "PWL"

// ---------------------------------------------------------------------------
// Destination ladder — next distinct liquidity after the nearest pool
// ---------------------------------------------------------------------------
float mergeTol = atr * TARGET_MERGE_ATR

float liqAbove2 = na
string liqAbove2Source = "—"
if hc > 0
    for i = 0 to hc - 1
        float level = array.get(highPools, i)
        bool swept = array.get(highSwept, i)
        bool distinct = na(liqAbove) or math.abs(level - liqAbove) > mergeTol
        if not swept and level > close and distinct
            if na(liqAbove2) or level < liqAbove2
                liqAbove2 := level
                liqAbove2Source := array.get(highStrength, i) >= 2 ? "EQH" : "SWING"

if dayLevelsAllowed and not pdhSwept and not na(prevDayHigh) and prevDayHigh > close and (na(liqAbove) or math.abs(prevDayHigh - liqAbove) > mergeTol)
    if na(liqAbove2) or prevDayHigh < liqAbove2
        liqAbove2 := prevDayHigh
        liqAbove2Source := "PDH"

if weekLevelsAllowed and not pwhSwept and not na(prevWeekHigh) and prevWeekHigh > close and (na(liqAbove) or math.abs(prevWeekHigh - liqAbove) > mergeTol)
    if na(liqAbove2) or prevWeekHigh < liqAbove2
        liqAbove2 := prevWeekHigh
        liqAbove2Source := "PWH"

float liqBelow2 = na
string liqBelow2Source = "—"
if lc > 0
    for i = 0 to lc - 1
        float level = array.get(lowPools, i)
        bool swept = array.get(lowSwept, i)
        bool distinct = na(liqBelow) or math.abs(level - liqBelow) > mergeTol
        if not swept and level < close and distinct
            if na(liqBelow2) or level > liqBelow2
                liqBelow2 := level
                liqBelow2Source := array.get(lowStrength, i) >= 2 ? "EQL" : "SWING"

if dayLevelsAllowed and not pdlSwept and not na(prevDayLow) and prevDayLow < close and (na(liqBelow) or math.abs(prevDayLow - liqBelow) > mergeTol)
    if na(liqBelow2) or prevDayLow > liqBelow2
        liqBelow2 := prevDayLow
        liqBelow2Source := "PDL"

if weekLevelsAllowed and not pwlSwept and not na(prevWeekLow) and prevWeekLow < close and (na(liqBelow) or math.abs(prevWeekLow - liqBelow) > mergeTol)
    if na(liqBelow2) or prevWeekLow > liqBelow2
        liqBelow2 := prevWeekLow
        liqBelow2Source := "PWL"

// ---------------------------------------------------------------------------
// Correction Engine — latest confirmed structural impulse
// ---------------------------------------------------------------------------
// If slow regime and confirmed local structure disagree, do not pretend a
// correction thesis is still clean. Freeze directional correction mapping
// until the conflict resolves.
bool regimeStructureConflict = regimeDir != 0 and structureDir != 0 and regimeDir != structureDir
int mapDir = regimeStructureConflict ? 0 : regimeDir != 0 ? regimeDir : structureDir

bool bullishReclaimEvt = not na(reclaimBelowLevel)
bool bearishReclaimEvt = not na(reclaimAboveLevel)
bool relevantReclaimEvt = mapDir == 1 ? bullishReclaimEvt : mapDir == -1 ? bearishReclaimEvt : false
float relevantReclaimLevel = mapDir == 1 ? reclaimBelowLevel : mapDir == -1 ? reclaimAboveLevel : na
string relevantReclaimSource = mapDir == 1 ? reclaimBelowSource : mapDir == -1 ? reclaimAboveSource : "—"
int reclaimEventDir = relevantReclaimEvt ? mapDir : 0

float destination1 = mapDir == 1 ? liqAbove : mapDir == -1 ? liqBelow : na
string destination1Source = mapDir == 1 ? liqAboveSource : mapDir == -1 ? liqBelowSource : "—"
float destination2 = mapDir == 1 ? liqAbove2 : mapDir == -1 ? liqBelow2 : na
string destination2Source = mapDir == 1 ? liqAbove2Source : mapDir == -1 ? liqBelow2Source : "—"
float destinationDistanceAtr = not na(destination1) and atr > 0 ? math.abs(destination1 - close) / atr : na
bool destinationNear = not na(destinationDistanceAtr) and destinationDistanceAtr <= TARGET_NEAR_ATR

bool destinationHitUp = barstate.isconfirmed and mapDir[1] == 1 and not na(destination1[1]) and high >= destination1[1]
bool destinationHitDown = barstate.isconfirmed and mapDir[1] == -1 and not na(destination1[1]) and low <= destination1[1]
bool destinationHitEvt = destinationHitUp or destinationHitDown
float destinationHitLevel = destinationHitEvt ? destination1[1] : na
string destinationHitSource = destinationHitEvt ? destination1Source[1] : "—"

string destinationTxtBase = na(destination1) ? "—" :
     f_price(destination1) + " • " + destination1Source +
     (destinationNear ? " • PRÓX." : "") +
     (not na(destination2) ? " → " + f_price(destination2) + " • " + destination2Source : "")
string destinationTxt = destinationHitEvt ?
     "ATINGIDO " + f_price(destinationHitLevel) + " • " + destinationHitSource +
     (not na(destination1) ? " → " + f_price(destination1) + " • " + destination1Source : "") :
     destinationTxtBase

float impulseLow = na
float impulseHigh = na
int impulseStartBar = na
int impulseEndBar = na

if mapDir == 1 and not na(lastSwingHigh)
    if not na(lastSwingLowBar) and lastSwingLowBar < lastSwingHighBar
        impulseLow := lastSwingLow
        impulseStartBar := lastSwingLowBar
    else if not na(prevSwingLowBar) and prevSwingLowBar < lastSwingHighBar
        impulseLow := prevSwingLow
        impulseStartBar := prevSwingLowBar
    impulseHigh := lastSwingHigh
    impulseEndBar := lastSwingHighBar

if mapDir == -1 and not na(lastSwingLow)
    if not na(lastSwingHighBar) and lastSwingHighBar < lastSwingLowBar
        impulseHigh := lastSwingHigh
        impulseStartBar := lastSwingHighBar
    else if not na(prevSwingHighBar) and prevSwingHighBar < lastSwingLowBar
        impulseHigh := prevSwingHigh
        impulseStartBar := prevSwingHighBar
    impulseLow := lastSwingLow
    impulseEndBar := lastSwingLowBar

bool useLiveImpulse = false
bool liveBullUsable = mapDir == 1 and liveImpulseDir == 1 and not na(liveImpulseStartBar) and not na(liveImpulseLow) and not na(liveImpulseHigh)
bool liveBearUsable = mapDir == -1 and liveImpulseDir == -1 and not na(liveImpulseStartBar) and not na(liveImpulseLow) and not na(liveImpulseHigh)
bool liveIsNewer = na(impulseEndBar) or (not na(liveImpulseBreakBar) and liveImpulseBreakBar > impulseEndBar)

if liveBullUsable and liveIsNewer
    impulseLow := liveImpulseLow
    impulseHigh := liveImpulseHigh
    impulseStartBar := liveImpulseStartBar
    impulseEndBar := bar_index
    useLiveImpulse := true

if liveBearUsable and liveIsNewer
    impulseLow := liveImpulseLow
    impulseHigh := liveImpulseHigh
    impulseStartBar := liveImpulseStartBar
    impulseEndBar := bar_index
    useLiveImpulse := true

float impulseRange = not na(impulseHigh) and not na(impulseLow) ? impulseHigh - impulseLow : na
bool correctionReady = not na(impulseRange) and impulseRange > syminfo.mintick * 20 and not na(impulseEndBar)

float fib382 = na
float fib500 = na
float fib618 = na
float fib786 = na

if correctionReady and mapDir == 1
    fib382 := impulseHigh - impulseRange * 0.382
    fib500 := impulseHigh - impulseRange * 0.500
    fib618 := impulseHigh - impulseRange * 0.618
    fib786 := impulseHigh - impulseRange * 0.786

if correctionReady and mapDir == -1
    fib382 := impulseLow + impulseRange * 0.382
    fib500 := impulseLow + impulseRange * 0.500
    fib618 := impulseLow + impulseRange * 0.618
    fib786 := impulseLow + impulseRange * 0.786

float t1Top = correctionReady ? math.max(fib382, fib500) : na
float t1Bottom = correctionReady ? math.min(fib382, fib500) : na
float fibT2Top = correctionReady ? math.max(fib500, fib618) : na
float fibT2Bottom = correctionReady ? math.min(fib500, fib618) : na
float t3Top = correctionReady ? math.max(fib618, fib786) : na
float t3Bottom = correctionReady ? math.min(fib618, fib786) : na

// Empirical correction depth: recent completed HH→HL or LL→LH pullbacks.
// With insufficient history, fall back to the classic 0.500–0.618 zone.
float bullQ25 = f_quantile(bullPullbacks, 0.25)
float bullMedian = f_quantile(bullPullbacks, 0.50)
float bullQ75 = f_quantile(bullPullbacks, 0.75)
float bearQ25 = f_quantile(bearPullbacks, 0.25)
float bearMedian = f_quantile(bearPullbacks, 0.50)
float bearQ75 = f_quantile(bearPullbacks, 0.75)

int pullbackSamples = mapDir == 1 ? array.size(bullPullbacks) : mapDir == -1 ? array.size(bearPullbacks) : 0
float pullbackQ25 = mapDir == 1 ? bullQ25 : mapDir == -1 ? bearQ25 : na
float pullbackMedian = mapDir == 1 ? bullMedian : mapDir == -1 ? bearMedian : na
float pullbackQ75 = mapDir == 1 ? bullQ75 : mapDir == -1 ? bearQ75 : na
bool empiricalReady = pullbackSamples >= PULLBACK_MIN_SAMPLES and not na(pullbackMedian)

float empiricalSpread = empiricalReady ? math.max(0.0, pullbackQ75 - pullbackQ25) : na
float empiricalHalfBand = empiricalReady ? math.max(0.045, math.min(0.11, empiricalSpread * 0.45)) : na
float primaryRatioShallow = empiricalReady ? math.max(0.236, math.min(0.786, pullbackMedian - empiricalHalfBand)) : 0.500
float primaryRatioDeep = empiricalReady ? math.max(primaryRatioShallow + 0.04, math.min(0.886, pullbackMedian + empiricalHalfBand)) : 0.618

float primaryA = na
float primaryB = na
if correctionReady and mapDir == 1
    primaryA := impulseHigh - impulseRange * primaryRatioShallow
    primaryB := impulseHigh - impulseRange * primaryRatioDeep
if correctionReady and mapDir == -1
    primaryA := impulseLow + impulseRange * primaryRatioShallow
    primaryB := impulseLow + impulseRange * primaryRatioDeep

float primaryTop = correctionReady ? math.max(primaryA, primaryB) : na
float primaryBottom = correctionReady ? math.min(primaryA, primaryB) : na
string correctionBaseModel = empiricalReady ? "ADAPT " + str.tostring(pullbackSamples) : "FIB"
string correctionModel = correctionReady ? (useLiveImpulse ? "LIVE/" : "") + correctionBaseModel : "—"
int correctionModelCode = not correctionReady ? 0 : useLiveImpulse ? (empiricalReady ? 4 : 3) : (empiricalReady ? 2 : 1)

// Current-impulse volume acceptance. This is a bar-volume approximation:
// VWAP is exact for the selected bars; VNode bins each bar's hlc3 volume into
// the impulse range and is intentionally NOT labeled as exchange POC.
//
// On an open realtime bar, acceptance intentionally stops at the previous
// confirmed bar and uses the previous confirmed LIVE extreme. This prevents a
// volume-confluence star from flashing only at candle close and disappearing
// again as soon as the next candle opens.
float impulseVwap = na
float impulseVNode = na
int acceptanceBars = 0
int acceptanceEndBar = impulseEndBar
float acceptanceLow = impulseLow
float acceptanceHigh = impulseHigh

if barstate.islast and correctionReady and not barstate.isconfirmed and useLiveImpulse
    acceptanceEndBar := bar_index - 1
    if mapDir == 1
        acceptanceHigh := nz(liveImpulseHigh[1], impulseHigh)
    if mapDir == -1
        acceptanceLow := nz(liveImpulseLow[1], impulseLow)

if barstate.islast and correctionReady and acceptanceEndBar >= impulseStartBar
    [calcVwap, calcVNode, calcBars] = f_impulse_acceptance(impulseStartBar, acceptanceEndBar, acceptanceLow, acceptanceHigh)
    impulseVwap := calcVwap
    impulseVNode := calcVNode
    acceptanceBars := calcBars

float invalidation = correctionReady ? (mapDir == 1 ? impulseLow - atr * INVALID_TOL_ATR : impulseHigh + atr * INVALID_TOL_ATR) : na

// Invalidation is a thesis lifecycle, not just another line.
// Intrabar crossing is shown as a test; only a confirmed close permanently
// invalidates the current impulse thesis. A new structural impulse resets it.
// Stable identity across LIVE -> confirmed-terminal-pivot transition.
// The thesis is anchored by impulse origin + direction, not by the evolving end bar.
int impulseKey = correctionReady and not na(impulseStartBar) ? impulseStartBar * 3 + (mapDir + 1) : na
bool invalidationBrokenNow = correctionReady and (mapDir == 1 ? close < invalidation : mapDir == -1 ? close > invalidation : false)

var int invalidatedImpulseKey = na
if barstate.isconfirmed and invalidationBrokenNow and not na(impulseKey)
    invalidatedImpulseKey := impulseKey

bool thesisInvalidated = correctionReady and not na(impulseKey) and invalidatedImpulseKey == impulseKey
bool correctionActive = correctionReady and not thesisInvalidated
string activeDestinationTxt = thesisInvalidated ? "—" : destinationTxt
bool activeDestinationNear = not thesisInvalidated and destinationNear

float invalidationDistance = correctionActive ? (mapDir == 1 ? close - invalidation : mapDir == -1 ? invalidation - close : na) : na
bool nearInvalidation = correctionActive and not invalidationBrokenNow and not na(invalidationDistance) and invalidationDistance >= 0 and invalidationDistance <= atr * INVALID_WARN_ATR

// ---------------------------------------------------------------------------
// Embedded Execution semantic kernel — Decision Panel consumer
// ---------------------------------------------------------------------------
// Same accepted semantics as src/core/execution.pine. This consumer reuses the
// already-computed Market Map direction/location geometry and adds no new map
// thesis.

// MTE-A
float exMteSource = hlc3
float exMteFast = f_ex_seeded_ema(exMteSource, EX_MTE_FAST_EMA)
float exMteSlow = f_ex_seeded_ema(exMteSource, EX_MTE_SLOW_EMA)
float exPrevClose = nz(close[1], close)
float exTrueRange = math.max(high - low, math.max(math.abs(high - exPrevClose), math.abs(low - exPrevClose)))
float exMteAtr = f_ex_seeded_rma(exTrueRange, EX_MTE_ATR_LEN)
float exMteCore = not na(exMteFast) and not na(exMteSlow) and not na(exMteAtr) and exMteAtr > 0.0 ? (exMteFast - exMteSlow) / exMteAtr : na
float exMteActivity = f_ex_seeded_rma(math.abs(exMteCore), EX_MTE_ACTIVITY_LEN)
float exMteAccel = not na(exMteCore) and not na(exMteCore[1]) ? exMteCore - exMteCore[1] : na
float exMteAccelActivity = f_ex_seeded_rma(math.abs(exMteAccel), EX_MTE_ACTIVITY_LEN)
bool exMteReady = not na(exMteCore) and not na(exMteActivity) and not na(exMteAccel) and not na(exMteAccelActivity) and exMteActivity > 0.0
float exMteNeutralBand = exMteReady ? EX_MTE_NEUTRAL_FACTOR * exMteActivity : na
float exMteTurnBand = exMteReady ? math.max(EX_MTE_TURN_FLOOR, EX_MTE_TURN_FACTOR * exMteAccelActivity) : na
float exMteAccelSemantic = exMteReady and math.abs(exMteAccel) <= EX_MTE_ACCEL_EPS ? 0.0 : exMteAccel

int exMteState = EX_MTE_NEUTRAL
if exMteReady
    if math.abs(exMteCore) <= exMteNeutralBand
        exMteState := EX_MTE_NEUTRAL
    else if exMteCore > 0.0
        exMteState := exMteAccelSemantic < -exMteTurnBand ? EX_MTE_TURN_DOWN :
             exMteAccelSemantic < 0.0 ? EX_MTE_UP_DECEL : EX_MTE_UP_ACCEL
    else
        exMteState := exMteAccelSemantic > exMteTurnBand ? EX_MTE_TURN_UP :
             exMteAccelSemantic > 0.0 ? EX_MTE_DOWN_DECEL : EX_MTE_DOWN_ACCEL

// RSE-A
float exRsiLocal = f_ex_rsi(close)
float exRsiStep = not na(exRsiLocal) and not na(exRsiLocal[1]) ? exRsiLocal - exRsiLocal[1] : na
bool exRsiReady = not na(exRsiLocal) and not na(exRsiStep)
float exRecentRsiMin = ta.lowest(exRsiLocal, EX_RSI_ZONE_MEMORY_BARS + 1)
float exRecentRsiMax = ta.highest(exRsiLocal, EX_RSI_ZONE_MEMORY_BARS + 1)
bool exRecentOversold = exRsiReady and not na(exRecentRsiMin) and exRecentRsiMin <= EX_RSI_OVERSOLD
bool exRecentOverbought = exRsiReady and not na(exRecentRsiMax) and exRecentRsiMax >= EX_RSI_OVERBOUGHT

int exRsiState = EX_RSI_NEUTRAL
if exRsiReady
    if exRsiLocal >= EX_RSI_EXTREME_OVERBOUGHT_LEVEL
        exRsiState := EX_RSI_EXTREME_OVERBOUGHT
    else if exRsiLocal <= EX_RSI_EXTREME_OVERSOLD_LEVEL
        exRsiState := EX_RSI_EXTREME_OVERSOLD
    else if exRecentOversold and exRsiLocal < EX_RSI_CENTER_HIGH and exRsiStep >= EX_RSI_MIN_STEP
        exRsiState := EX_RSI_RECOVERING_OVERSOLD
    else if exRecentOverbought and exRsiLocal > EX_RSI_CENTER_LOW and exRsiStep <= -EX_RSI_MIN_STEP
        exRsiState := EX_RSI_FADING_OVERBOUGHT
    else if exRsiLocal >= EX_RSI_OVERBOUGHT and exRsiStep >= EX_RSI_MIN_STEP
        exRsiState := EX_RSI_RECOVERING_OVERBOUGHT
    else if exRsiLocal <= EX_RSI_OVERSOLD and exRsiStep <= -EX_RSI_MIN_STEP
        exRsiState := EX_RSI_FADING_OVERSOLD
    else if exRsiLocal >= EX_RSI_CENTER_HIGH
        exRsiState := EX_RSI_BULL
    else if exRsiLocal <= EX_RSI_CENTER_LOW
        exRsiState := EX_RSI_BEAR

float exRsiContextValue = f_sec(contextTf, f_ex_rsi(close))
int exRsiContextDir = na(exRsiContextValue) ? 0 :
     exRsiContextValue >= EX_RSI_CENTER_HIGH ? 1 :
     exRsiContextValue <= EX_RSI_CENTER_LOW ? -1 : 0

// PSE-A
float exVolumeBase = f_ex_seeded_ema(volume, EX_PSE_VOLUME_EMA_LEN)
float exPriorVolumeBase = exVolumeBase[1]
bool exPseReady = not na(volume) and volume >= 0.0 and not na(exPriorVolumeBase) and exPriorVolumeBase > 0.0
float exRelativeVolume = exPseReady ? volume / exPriorVolumeBase : na
float exCandleSpan = high - low
float exPressureProxy = exCandleSpan == 0.0 ? 0.0 : math.max(-1.0, math.min(1.0, (2.0 * close - high - low) / exCandleSpan))
float exDirectionalPressure = exPseReady and mapDir != 0 ? exPressureProxy * mapDir : na
int exParticipationState = EX_PSE_NEUTRAL
if exPseReady and mapDir != 0
    exParticipationState := exRelativeVolume < EX_PSE_CONTRACTED_BELOW ? EX_PSE_WEAK :
         exRelativeVolume >= EX_PSE_EXPANDED_AT_OR_ABOVE and exDirectionalPressure >= EX_PSE_PRESSURE_MIN ? EX_PSE_CONFIRM :
         exRelativeVolume >= EX_PSE_EXPANDED_AT_OR_ABOVE and exDirectionalPressure <= -EX_PSE_PRESSURE_MIN ? EX_PSE_CONTRARY :
         EX_PSE_NEUTRAL

// Market Map -> Execution location bridge.
bool exRetestEvent = (mapDir == 1 and retestUp) or (mapDir == -1 and retestDown)
bool exReclaimEvent = relevantReclaimEvt and mapDir != 0
bool exCoherentMap = mapDir != 0 and not thesisInvalidated and not regimeStructureConflict and not na(atr) and atr > 0

var int exBridgeDirection = 0
var int exLastRetestBar = na
var int exLastReclaimBar = na
var int exLastRetestTime = na
var int exLastReclaimTime = na

if not exCoherentMap
    exBridgeDirection := 0
    exLastRetestBar := na
    exLastReclaimBar := na
    exLastRetestTime := na
    exLastReclaimTime := na
else
    if exBridgeDirection != 0 and exBridgeDirection != mapDir
        exLastRetestBar := na
        exLastReclaimBar := na
        exLastRetestTime := na
        exLastReclaimTime := na
    exBridgeDirection := mapDir
    if exRetestEvent
        exLastRetestBar := bar_index
        exLastRetestTime := time
    if exReclaimEvent
        exLastReclaimBar := bar_index
        exLastReclaimTime := time

bool exFreshRetest = exCoherentMap and not na(exLastRetestBar) and bar_index - exLastRetestBar >= 0 and bar_index - exLastRetestBar <= EX_EVENT_HOLD_BARS and
     (na(exLastRetestTime) or time - exLastRetestTime <= EX_EVENT_HOLD_MAX_MS)
bool exFreshReclaim = exCoherentMap and not na(exLastReclaimBar) and bar_index - exLastReclaimBar >= 0 and bar_index - exLastReclaimBar <= EX_EVENT_HOLD_BARS and
     (na(exLastReclaimTime) or time - exLastReclaimTime <= EX_EVENT_HOLD_MAX_MS)

bool exEnvelopeReady = correctionActive and not na(t1Top) and not na(t1Bottom) and not na(primaryTop) and not na(primaryBottom) and not na(t3Top) and not na(t3Bottom)
float exEnvelopeTop = exEnvelopeReady ? math.max(t1Top, math.max(primaryTop, t3Top)) : na
float exEnvelopeBottom = exEnvelopeReady ? math.min(t1Bottom, math.min(primaryBottom, t3Bottom)) : na

int exLocation = EX_LOC_OUTSIDE
if exCoherentMap
    if exFreshReclaim
        exLocation := EX_LOC_RECLAIM
    else if exFreshRetest
        exLocation := EX_LOC_RETEST
    else if exEnvelopeReady and close >= exEnvelopeBottom and close <= exEnvelopeTop
        exLocation := EX_LOC_IN_CORRECTION
    else if exEnvelopeReady and mapDir == 1 and close > exEnvelopeTop and close - exEnvelopeTop <= atr * EX_APPROACH_ATR
        exLocation := EX_LOC_APPROACHING
    else if exEnvelopeReady and mapDir == -1 and close < exEnvelopeBottom and exEnvelopeBottom - close <= atr * EX_APPROACH_ATR
        exLocation := EX_LOC_APPROACHING
    else if destinationNear
        exLocation := EX_LOC_DESTINATION_NEAR

bool exRelevantLocation = exLocation == EX_LOC_APPROACHING or exLocation == EX_LOC_IN_CORRECTION or exLocation == EX_LOC_RETEST or exLocation == EX_LOC_RECLAIM

// ---------------------------------------------------------------------------
// Suite 0.2 Opportunity Engine — embedded parity consumer
// ---------------------------------------------------------------------------
bool exOppZoneTouchNow = correctionActive and not na(primaryTop) and not na(primaryBottom) and high >= primaryBottom and low <= primaryTop
bool exOppReactionOnBar = exRetestEvent or exReclaimEvent or exOppZoneTouchNow
int exOppStructuralBreakDir = breakUp ? 1 : breakDown ? -1 : 0

var int exOppCurrentRegimeDir = 0
var int exOppCurrentRegimeLen = 0
var int exOppPreviousRegimeDir = 0
var int exOppPreviousRegimeLen = 0
var int exOppPreviousRegimeEndBar = na
var int exOppLastBreakLongBar = na
var int exOppLastBreakShortBar = na
var int exOppLastReactionLongBar = na
var int exOppLastReactionShortBar = na
var int exOppSeenReactionThesisKey = na
var int exOppPendingReversalDir = 0
var int exOppPendingReversalOnsetBar = na

bool exOppBreakoutEvent = false
bool exOppReaccelerationEvent = false
bool exOppRegimeReversalEvent = false
int exOppBreakContext = EX_BREAK_OTHER
int exOppBreakRegimeAge = 0

if barstate.isconfirmed
    if exOppStructuralBreakDir != 0
        int previousSameBreak = exOppStructuralBreakDir == 1 ? exOppLastBreakLongBar : exOppLastBreakShortBar
        int lastReaction = exOppStructuralBreakDir == 1 ? exOppLastReactionLongBar : exOppLastReactionShortBar

        int matureDir = 0
        if exOppCurrentRegimeDir != 0 and exOppCurrentRegimeLen >= EX_REVERSAL_PRIOR_REGIME_MIN_BARS
            matureDir := exOppCurrentRegimeDir
        else if exOppCurrentRegimeDir == 0 and exOppPreviousRegimeDir != 0 and exOppPreviousRegimeLen >= EX_REVERSAL_PRIOR_REGIME_MIN_BARS
            matureDir := exOppPreviousRegimeDir

        bool pullbackSincePreviousBreak = not na(previousSameBreak) and not na(lastReaction) and previousSameBreak < lastReaction and lastReaction < bar_index
        bool oppositeMatureRegime = matureDir == -exOppStructuralBreakDir
        bool coherentBreak = mapDir == exOppStructuralBreakDir and regimeDir == exOppStructuralBreakDir and not regimeStructureConflict and not thesisInvalidated

        exOppBreakRegimeAge := exOppCurrentRegimeDir == exOppStructuralBreakDir ? exOppCurrentRegimeLen : 0
        exOppBreakContext := oppositeMatureRegime ? EX_BREAK_EARLY_TRANSITION :
             not coherentBreak ? EX_BREAK_OTHER :
             pullbackSincePreviousBreak or exOppReactionOnBar ? EX_BREAK_PULLBACK_RESOLUTION :
             exOppBreakRegimeAge >= EX_REACCELERATION_REGIME_MIN_BARS and not na(previousSameBreak) ? EX_BREAK_REACCELERATION :
             EX_BREAK_FRESH_EXPANSION

        exOppReaccelerationEvent := exOppBreakContext == EX_BREAK_REACCELERATION
        exOppBreakoutEvent := coherentBreak and (exOppBreakContext == EX_BREAK_FRESH_EXPANSION or exOppBreakContext == EX_BREAK_OTHER)

        if exOppBreakContext == EX_BREAK_EARLY_TRANSITION
            exOppPendingReversalDir := exOppStructuralBreakDir
            exOppPendingReversalOnsetBar := bar_index

        if exOppStructuralBreakDir == 1
            exOppLastBreakLongBar := bar_index
        else
            exOppLastBreakShortBar := bar_index

    bool exOppNewThesis = not na(impulseKey) and (na(impulseKey[1]) or impulseKey != impulseKey[1])
    bool exOppFirstReaction = not na(impulseKey) and impulseKey != exOppSeenReactionThesisKey and mapDir != 0 and not regimeStructureConflict and not thesisInvalidated and
         (exRetestEvent or exReclaimEvent or (not exOppNewThesis and exOppZoneTouchNow))
    if exOppFirstReaction
        exOppSeenReactionThesisKey := impulseKey
        if mapDir == 1
            exOppLastReactionLongBar := bar_index
        else
            exOppLastReactionShortBar := bar_index

    if exOppPendingReversalDir != 0
        if regimeDir == exOppPendingReversalDir and mapDir == exOppPendingReversalDir and not regimeStructureConflict and not thesisInvalidated
            exOppRegimeReversalEvent := true
            exOppPendingReversalDir := 0
            exOppPendingReversalOnsetBar := na
        else if regimeDir != 0 and regimeDir != exOppPendingReversalDir
            exOppPendingReversalDir := 0
            exOppPendingReversalOnsetBar := na

    if regimeDir == exOppCurrentRegimeDir and regimeDir != 0
        exOppCurrentRegimeLen += 1
    else if regimeDir == 0
        if exOppCurrentRegimeDir != 0
            exOppPreviousRegimeDir := exOppCurrentRegimeDir
            exOppPreviousRegimeLen := exOppCurrentRegimeLen
            exOppPreviousRegimeEndBar := bar_index - 1
        exOppCurrentRegimeDir := 0
        exOppCurrentRegimeLen := 0
    else
        if exOppCurrentRegimeDir != 0
            exOppPreviousRegimeDir := exOppCurrentRegimeDir
            exOppPreviousRegimeLen := exOppCurrentRegimeLen
            exOppPreviousRegimeEndBar := bar_index - 1

        if exOppPreviousRegimeDir == -regimeDir and exOppPreviousRegimeLen >= EX_REVERSAL_PRIOR_REGIME_MIN_BARS and not exOppRegimeReversalEvent
            int candidateBreak = regimeDir == 1 ? exOppLastBreakLongBar : exOppLastBreakShortBar
            exOppPendingReversalDir := regimeDir
            exOppPendingReversalOnsetBar := not na(candidateBreak) and (na(exOppPreviousRegimeEndBar) or candidateBreak > exOppPreviousRegimeEndBar) ? candidateBreak : bar_index
            if mapDir == regimeDir and not regimeStructureConflict and not thesisInvalidated
                exOppRegimeReversalEvent := true
                exOppPendingReversalDir := 0
                exOppPendingReversalOnsetBar := na

        exOppCurrentRegimeDir := regimeDir
        exOppCurrentRegimeLen := 1

// TREND_OPPORTUNITY_V2 frame.
var int exTrendOppKind = EX_OPP_NONE
var int exTrendOppStage = EX_OPP_STAGE_NONE
var int exTrendOppDir = 0
var int exTrendOppSourceBar = na
var float exTrendOppBreakLevel = na
var bool exTrendOppSourceStrong = false

if barstate.isconfirmed
    if exTrendOppStage != EX_OPP_STAGE_NONE
        bool trendInvalid = mapDir != exTrendOppDir or thesisInvalidated or regimeStructureConflict or fakeoutUpEvt or fakeoutDownEvt or destinationNear or exRelevantLocation
        if trendInvalid
            exTrendOppKind := EX_OPP_NONE
            exTrendOppStage := EX_OPP_STAGE_NONE
            exTrendOppDir := 0
            exTrendOppSourceBar := na
            exTrendOppBreakLevel := na
            exTrendOppSourceStrong := false
        else if exTrendOppKind == EX_OPP_BREAKOUT_EXPANSION or exTrendOppKind == EX_OPP_REACCELERATION
            int trendAge = bar_index - exTrendOppSourceBar
            if trendAge == 1
                bool held1 = exTrendOppDir == 1 ? close > exTrendOppBreakLevel : close < exTrendOppBreakLevel
                if not held1
                    exTrendOppKind := EX_OPP_NONE
                    exTrendOppStage := EX_OPP_STAGE_NONE
                    exTrendOppDir := 0
                    exTrendOppSourceBar := na
                    exTrendOppBreakLevel := na
                    exTrendOppSourceStrong := false
                else
                    exTrendOppStage := exTrendOppSourceStrong ? EX_OPP_STAGE_STRONG : EX_OPP_STAGE_CANDIDATE
            else if trendAge == 2
                bool heldPrev = exTrendOppDir == 1 ? close[1] > exTrendOppBreakLevel : close[1] < exTrendOppBreakLevel
                bool heldNow = exTrendOppDir == 1 ? close > exTrendOppBreakLevel : close < exTrendOppBreakLevel
                if heldPrev and heldNow
                    exTrendOppStage := EX_OPP_STAGE_ACCEPTED
                else
                    exTrendOppKind := EX_OPP_NONE
                    exTrendOppStage := EX_OPP_STAGE_NONE
                    exTrendOppDir := 0
                    exTrendOppSourceBar := na
                    exTrendOppBreakLevel := na
                    exTrendOppSourceStrong := false
            else if trendAge > 2 and exTrendOppStage != EX_OPP_STAGE_ACCEPTED
                exTrendOppKind := EX_OPP_NONE
                exTrendOppStage := EX_OPP_STAGE_NONE
                exTrendOppDir := 0
                exTrendOppSourceBar := na
                exTrendOppBreakLevel := na
                exTrendOppSourceStrong := false

    int newTrendKind = exOppRegimeReversalEvent ? EX_OPP_REGIME_REVERSAL :
         exOppReaccelerationEvent ? EX_OPP_REACCELERATION :
         exOppBreakoutEvent ? EX_OPP_BREAKOUT_EXPANSION : EX_OPP_NONE
    if newTrendKind != EX_OPP_NONE
        int newTrendDir = exOppRegimeReversalEvent ? regimeDir : exOppStructuralBreakDir
        exTrendOppKind := newTrendKind
        exTrendOppDir := newTrendDir
        exTrendOppSourceBar := bar_index
        if newTrendKind == EX_OPP_REGIME_REVERSAL
            exTrendOppStage := EX_OPP_STAGE_ACCEPTED
            exTrendOppBreakLevel := na
            exTrendOppSourceStrong := false
        else
            exTrendOppStage := EX_OPP_STAGE_CANDIDATE
            exTrendOppBreakLevel := lastBreakLevel
            int sourcePseState = f_ex_pse_state_dir(newTrendDir, exPseReady, exRelativeVolume, exPressureProxy)
            float penetrationAtr = not na(exTrendOppBreakLevel) and not na(atr) and atr > 0 ? newTrendDir * (close - exTrendOppBreakLevel) / atr : na
            exTrendOppSourceStrong := not na(penetrationAtr) and penetrationAtr >= EX_BREAK_DECISIVE_ATR and sourcePseState == EX_PSE_CONFIRM

int exTrendParticipationState = f_ex_pse_state_dir(exTrendOppDir, exPseReady, exRelativeVolume, exPressureProxy)
bool exTrendMomentumAligned = f_ex_momentum_aligned_dir(exTrendOppDir, exMteState)
bool exTrendMomentumOpposes = f_ex_momentum_opposes_dir(exTrendOppDir, exMteState)
bool exTrendRsiSupportive = f_ex_rsi_supports_dir(exTrendOppDir, exRsiState, exRsiContextDir)
bool exTrendRsiOpposes = f_ex_rsi_opposes_dir(exTrendOppDir, exRsiState, exRsiContextDir)

var int exTrendReadiness = EX_READY_WAIT
var int exTrendReadinessDir = 0
bool exTrendPreparingEntered = false
bool exTrendArmedEntered = false
bool exTrendConfirmEvent = false

if barstate.isconfirmed
    int trPrev = exTrendReadiness
    int trPrevDir = exTrendReadinessDir
    int trNext = trPrev
    int trNextDir = trPrevDir
    bool validTrendFrame = exTrendOppStage != EX_OPP_STAGE_NONE and exTrendOppDir != 0

    if not validTrendFrame
        trNext := EX_READY_WAIT
        trNextDir := 0
    else if trPrevDir != 0 and trPrevDir != exTrendOppDir
        trNext := EX_READY_WAIT
        trNextDir := 0
    else
        if exTrendOppStage == EX_OPP_STAGE_CANDIDATE
            if trPrev == EX_READY_PREP or trPrev == EX_READY_ARMED
                trNext := EX_READY_WAIT
                trNextDir := 0
            else if trPrev == EX_READY_CONFIRMED
                trNext := EX_READY_ALIGNED
                trNextDir := exTrendOppDir
            else if trPrev == EX_READY_ALIGNED
                if exTrendMomentumOpposes and exTrendRsiOpposes
                    trNext := EX_READY_WAIT
                    trNextDir := 0
                else
                    trNext := EX_READY_ALIGNED
                    trNextDir := exTrendOppDir
            else
                trNext := EX_READY_WAIT
                trNextDir := 0
        else if trPrev == EX_READY_WAIT
            if exTrendMomentumOpposes or exTrendParticipationState == EX_PSE_CONTRARY
                trNext := EX_READY_WAIT
                trNextDir := 0
            else if exTrendOppStage == EX_OPP_STAGE_STRONG
                trNext := EX_READY_PREP
                trNextDir := exTrendOppDir
                exTrendPreparingEntered := true
            else if exTrendOppStage >= EX_OPP_STAGE_ACCEPTED
                if exTrendRsiSupportive and not exTrendMomentumOpposes
                    trNext := EX_READY_ARMED
                    trNextDir := exTrendOppDir
                    exTrendArmedEntered := true
                else
                    trNext := EX_READY_PREP
                    trNextDir := exTrendOppDir
                    exTrendPreparingEntered := true
        else if trPrev == EX_READY_PREP
            if exTrendMomentumOpposes or exTrendParticipationState == EX_PSE_CONTRARY
                trNext := EX_READY_WAIT
                trNextDir := 0
            else if exTrendOppStage == EX_OPP_STAGE_STRONG
                if exTrendMomentumAligned and exTrendRsiSupportive
                    trNext := EX_READY_ARMED
                    trNextDir := exTrendOppDir
                    exTrendArmedEntered := true
                else
                    trNext := EX_READY_PREP
                    trNextDir := exTrendOppDir
            else if exTrendOppStage >= EX_OPP_STAGE_ACCEPTED
                if exTrendRsiSupportive and not exTrendMomentumOpposes
                    trNext := EX_READY_ARMED
                    trNextDir := exTrendOppDir
                    exTrendArmedEntered := true
                else
                    trNext := EX_READY_PREP
                    trNextDir := exTrendOppDir
            else
                trNext := EX_READY_WAIT
                trNextDir := 0
        else if trPrev == EX_READY_ARMED
            if exTrendMomentumOpposes or exTrendRsiOpposes or exTrendParticipationState == EX_PSE_CONTRARY
                trNext := EX_READY_WAIT
                trNextDir := 0
            else if exTrendOppStage >= EX_OPP_STAGE_ACCEPTED and not exTrendMomentumOpposes and exTrendRsiSupportive and (exTrendParticipationState == EX_PSE_CONFIRM or exTrendOppSourceStrong)
                trNext := EX_READY_CONFIRMED
                trNextDir := exTrendOppDir
                exTrendConfirmEvent := true
            else
                trNext := EX_READY_ARMED
                trNextDir := exTrendOppDir
        else if trPrev == EX_READY_CONFIRMED
            trNext := EX_READY_ALIGNED
            trNextDir := exTrendOppDir
        else if trPrev == EX_READY_ALIGNED
            if exTrendMomentumOpposes and exTrendRsiOpposes
                trNext := EX_READY_WAIT
                trNextDir := 0
            else
                trNext := EX_READY_ALIGNED
                trNextDir := exTrendOppDir

    exTrendReadiness := trNext
    exTrendReadinessDir := trNextDir

// RANGE_ROTATION box and EDGE_REJECTION detector.
bool exRangeBoxValuesReady = not na(prevSwingHigh) and not na(lastSwingHigh) and not na(prevSwingLow) and not na(lastSwingLow) and
     not na(prevSwingHighBar) and not na(lastSwingHighBar) and not na(prevSwingLowBar) and not na(lastSwingLowBar) and not na(atr) and atr > 0
bool exRangeCycleOrder = exRangeBoxValuesReady and prevSwingHighBar < lastSwingHighBar and prevSwingLowBar < lastSwingLowBar and
     math.max(prevSwingHighBar, prevSwingLowBar) < math.min(lastSwingHighBar, lastSwingLowBar)
bool exRangeVerticalOrder = exRangeBoxValuesReady and math.min(prevSwingHigh, lastSwingHigh) > math.max(prevSwingLow, lastSwingLow)
float exRangeBoxHigh = exRangeBoxValuesReady ? (prevSwingHigh + lastSwingHigh) * 0.5 : na
float exRangeBoxLow = exRangeBoxValuesReady ? (prevSwingLow + lastSwingLow) * 0.5 : na
float exRangeBoxHeight = exRangeBoxValuesReady ? exRangeBoxHigh - exRangeBoxLow : na
float exRangeBoundaryDrift = exRangeBoxValuesReady and not na(exRangeBoxHeight) and exRangeBoxHeight > 0 ? math.max(math.abs(prevSwingHigh - lastSwingHigh), math.abs(prevSwingLow - lastSwingLow)) / exRangeBoxHeight : na
bool exRangeBoxValid = exRangeCycleOrder and exRangeVerticalOrder and not na(exRangeBoxHeight) and exRangeBoxHeight > 0 and exRangeBoxHeight / atr >= EX_RANGE_MIN_HEIGHT_ATR and exRangeBoundaryDrift <= EX_RANGE_BOUNDARY_DRIFT_MAX
float exRangeBoxMid = exRangeBoxValid ? (exRangeBoxHigh + exRangeBoxLow) * 0.5 : na
float exRangeBoxEdge = exRangeBoxValid ? exRangeBoxHeight * EX_RANGE_EDGE_FRACTION : na

var float exRangeDetectorHigh = na
var float exRangeDetectorLow = na
var float exRangeDetectorEdge = na
var bool exRangeLowerReady = true
var bool exRangeUpperReady = true

var int exRangeOppStage = EX_OPP_STAGE_NONE
var int exRangeOppDir = 0
var int exRangeOppSourceBar = na
var float exRangeOppHigh = na
var float exRangeOppLow = na
var float exRangeOppMid = na
var float exRangeOppEdge = na
var float exRangeOppSourceClose = na

bool exRangeSourceLong = false
bool exRangeSourceShort = false
bool exRangeSourceAmbiguous = false

if barstate.isconfirmed
    if exRangeOppStage != EX_OPP_STAGE_NONE
        bool sourceCompatible = exRangeBoxValid and not na(exRangeOppHigh) and not na(exRangeOppLow) and not na(exRangeOppEdge) and
             math.abs(exRangeBoxHigh - exRangeOppHigh) <= math.max(exRangeBoxEdge, exRangeOppEdge) and
             math.abs(exRangeBoxLow - exRangeOppLow) <= math.max(exRangeBoxEdge, exRangeOppEdge) and
             math.min(exRangeBoxHigh, exRangeOppHigh) > math.max(exRangeBoxLow, exRangeOppLow)
        bool sourceInvalidated = exRangeOppDir == 1 ? close < exRangeOppLow : close > exRangeOppHigh
        bool sourceOppositeReached = exRangeOppDir == 1 ? high >= exRangeOppHigh - exRangeOppEdge : low <= exRangeOppLow + exRangeOppEdge
        if not sourceCompatible or sourceInvalidated or sourceOppositeReached
            exRangeOppStage := EX_OPP_STAGE_NONE
            exRangeOppDir := 0
            exRangeOppSourceBar := na
            exRangeOppHigh := na
            exRangeOppLow := na
            exRangeOppMid := na
            exRangeOppEdge := na
            exRangeOppSourceClose := na
        else if exRangeOppStage == EX_OPP_STAGE_STRONG
            int rangeAge = bar_index - exRangeOppSourceBar
            bool insideSource = close >= exRangeOppLow and close <= exRangeOppHigh
            bool progress = exRangeOppDir == 1 ? close > exRangeOppSourceClose : close < exRangeOppSourceClose
            if rangeAge == 1 and insideSource and progress
                exRangeOppStage := EX_OPP_STAGE_ACCEPTED
            else if rangeAge >= 1
                exRangeOppStage := EX_OPP_STAGE_NONE
                exRangeOppDir := 0
                exRangeOppSourceBar := na
                exRangeOppHigh := na
                exRangeOppLow := na
                exRangeOppMid := na
                exRangeOppEdge := na
                exRangeOppSourceClose := na

    if not exRangeBoxValid
        exRangeDetectorHigh := na
        exRangeDetectorLow := na
        exRangeDetectorEdge := na
        exRangeLowerReady := true
        exRangeUpperReady := true
    else
        bool detectorCompatible = not na(exRangeDetectorHigh) and not na(exRangeDetectorLow) and not na(exRangeDetectorEdge) and
             math.abs(exRangeBoxHigh - exRangeDetectorHigh) <= math.max(exRangeBoxEdge, exRangeDetectorEdge) and
             math.abs(exRangeBoxLow - exRangeDetectorLow) <= math.max(exRangeBoxEdge, exRangeDetectorEdge) and
             math.min(exRangeBoxHigh, exRangeDetectorHigh) > math.max(exRangeBoxLow, exRangeDetectorLow)
        if not detectorCompatible
            exRangeLowerReady := true
            exRangeUpperReady := true
        exRangeDetectorHigh := exRangeBoxHigh
        exRangeDetectorLow := exRangeBoxLow
        exRangeDetectorEdge := exRangeBoxEdge

        if close >= exRangeBoxLow and close <= exRangeBoxHigh
            if close >= exRangeBoxMid
                exRangeLowerReady := true
            if close <= exRangeBoxMid
                exRangeUpperReady := true

            bool lowerTouch = low <= exRangeBoxLow + exRangeBoxEdge
            bool upperTouch = high >= exRangeBoxHigh - exRangeBoxEdge
            bool longRawReclaim = not na(reclaimBelowLevel) and lowerTouch and close > exRangeBoxLow
            bool shortRawReclaim = not na(reclaimAboveLevel) and upperTouch and close < exRangeBoxHigh
            bool longEdgeReject = lowerTouch and close >= exRangeBoxLow + exRangeBoxEdge and exPressureProxy > 0
            bool shortEdgeReject = upperTouch and close <= exRangeBoxHigh - exRangeBoxEdge and exPressureProxy < 0

            bool lowerEvent = exRangeLowerReady and (longRawReclaim or longEdgeReject)
            bool upperEvent = exRangeUpperReady and (shortRawReclaim or shortEdgeReject)
            exRangeSourceLong := lowerEvent and longEdgeReject and not longRawReclaim
            exRangeSourceShort := upperEvent and shortEdgeReject and not shortRawReclaim
            exRangeSourceAmbiguous := exRangeSourceLong and exRangeSourceShort

            if lowerEvent
                exRangeLowerReady := false
            if upperEvent
                exRangeUpperReady := false

            if not exRangeSourceAmbiguous and (exRangeSourceLong or exRangeSourceShort)
                exRangeOppStage := EX_OPP_STAGE_STRONG
                exRangeOppDir := exRangeSourceLong ? 1 : -1
                exRangeOppSourceBar := bar_index
                exRangeOppHigh := exRangeBoxHigh
                exRangeOppLow := exRangeBoxLow
                exRangeOppMid := exRangeBoxMid
                exRangeOppEdge := exRangeBoxEdge
                exRangeOppSourceClose := close
            else if exRangeSourceAmbiguous
                exRangeOppStage := EX_OPP_STAGE_NONE
                exRangeOppDir := 0
                exRangeOppSourceBar := na
                exRangeOppHigh := na
                exRangeOppLow := na
                exRangeOppMid := na
                exRangeOppEdge := na
                exRangeOppSourceClose := na

int exRangeParticipationState = f_ex_pse_state_dir(exRangeOppDir, exPseReady, exRelativeVolume, exPressureProxy)
bool exRangeMomentumAligned = f_ex_momentum_aligned_dir(exRangeOppDir, exMteState)
bool exRangeMomentumOpposes = f_ex_momentum_opposes_dir(exRangeOppDir, exMteState)
bool exRangeRsiLocalSupportive = f_ex_rsi_local_supports_dir(exRangeOppDir, exRsiState)
bool exRangeRsiLocalOpposes = f_ex_rsi_local_opposes_dir(exRangeOppDir, exRsiState)
int exRangeIgnitionCount = (exRangeMomentumAligned ? 1 : 0) + (exRangeRsiLocalSupportive ? 1 : 0) + (exRangeParticipationState == EX_PSE_CONFIRM ? 1 : 0)
bool exRangeHardOpposition = exRangeMomentumOpposes and exRangeRsiLocalOpposes

var int exRangeReadiness = EX_READY_WAIT
var int exRangeReadinessDir = 0
var int exRangeReadinessSourceBar = na
bool exRangeArmedEntered = false
bool exRangeConfirmEvent = false

if barstate.isconfirmed
    int rrPrev = exRangeReadiness
    int rrPrevDir = exRangeReadinessDir
    bool sourceReset = exRangeOppStage != EX_OPP_STAGE_NONE and not na(exRangeOppSourceBar) and not na(exRangeReadinessSourceBar) and exRangeOppSourceBar != exRangeReadinessSourceBar
    if sourceReset
        rrPrev := EX_READY_WAIT
        rrPrevDir := 0

    int rrNext = rrPrev
    int rrNextDir = rrPrevDir

    if exRangeOppStage == EX_OPP_STAGE_NONE or exRangeOppDir == 0
        rrNext := EX_READY_WAIT
        rrNextDir := 0
        exRangeReadinessSourceBar := na
    else
        exRangeReadinessSourceBar := exRangeOppSourceBar
        if exRangeOppStage == EX_OPP_STAGE_STRONG
            if exRangeHardOpposition
                rrNext := EX_READY_WAIT
                rrNextDir := 0
            else if exRangeIgnitionCount >= 1
                rrNext := EX_READY_ARMED
                rrNextDir := exRangeOppDir
                exRangeArmedEntered := rrPrev != EX_READY_ARMED or rrPrevDir != exRangeOppDir
            else
                rrNext := EX_READY_WAIT
                rrNextDir := 0
        else if exRangeOppStage == EX_OPP_STAGE_ACCEPTED
            if rrPrev == EX_READY_ARMED and rrPrevDir == exRangeOppDir
                rrNext := EX_READY_CONFIRMED
                rrNextDir := exRangeOppDir
                exRangeConfirmEvent := true
            else if rrPrev == EX_READY_CONFIRMED and rrPrevDir == exRangeOppDir
                rrNext := EX_READY_ALIGNED
                rrNextDir := exRangeOppDir
            else if rrPrev == EX_READY_ALIGNED and rrPrevDir == exRangeOppDir
                rrNext := EX_READY_ALIGNED
                rrNextDir := exRangeOppDir
            else
                rrNext := EX_READY_WAIT
                rrNextDir := 0

    exRangeReadiness := rrNext
    exRangeReadinessDir := rrNextDir

bool exMomentumAligned = mapDir == 1 ? (exMteState == EX_MTE_TURN_UP or exMteState == EX_MTE_UP_ACCEL) :
     mapDir == -1 ? (exMteState == EX_MTE_TURN_DOWN or exMteState == EX_MTE_DOWN_ACCEL) : false
bool exMomentumStronglyOpposes = mapDir == 1 ? (exMteState == EX_MTE_TURN_DOWN or exMteState == EX_MTE_DOWN_ACCEL) :
     mapDir == -1 ? (exMteState == EX_MTE_TURN_UP or exMteState == EX_MTE_UP_ACCEL) : true
bool exMomentumDeteriorates = mapDir == 1 ? (exMteState == EX_MTE_UP_DECEL or exMteState == EX_MTE_TURN_DOWN or exMteState == EX_MTE_DOWN_ACCEL or exMteState == EX_MTE_DOWN_DECEL) :
     mapDir == -1 ? (exMteState == EX_MTE_DOWN_DECEL or exMteState == EX_MTE_TURN_UP or exMteState == EX_MTE_UP_ACCEL or exMteState == EX_MTE_UP_DECEL) : false

bool exRsiLocalSupportive = mapDir == 1 ? (exRsiState == EX_RSI_BULL or exRsiState == EX_RSI_RECOVERING_OVERSOLD or exRsiState == EX_RSI_RECOVERING_OVERBOUGHT) :
     mapDir == -1 ? (exRsiState == EX_RSI_BEAR or exRsiState == EX_RSI_FADING_OVERBOUGHT or exRsiState == EX_RSI_FADING_OVERSOLD) : false
bool exRsiSupportive = exRsiLocalSupportive and exRsiContextDir != -mapDir
bool exRsiLocalOpposes = mapDir == 1 ? (exRsiState == EX_RSI_BEAR or exRsiState == EX_RSI_FADING_OVERBOUGHT or exRsiState == EX_RSI_EXTREME_OVERBOUGHT) :
     mapDir == -1 ? (exRsiState == EX_RSI_BULL or exRsiState == EX_RSI_RECOVERING_OVERSOLD or exRsiState == EX_RSI_EXTREME_OVERSOLD) : true
bool exRsiOpposes = exRsiLocalOpposes or (mapDir != 0 and exRsiContextDir == -mapDir)
bool exRsiDeteriorates = mapDir == 1 ? (exRsiState == EX_RSI_FADING_OVERBOUGHT or exRsiState == EX_RSI_EXTREME_OVERBOUGHT) :
     mapDir == -1 ? (exRsiState == EX_RSI_RECOVERING_OVERSOLD or exRsiState == EX_RSI_EXTREME_OVERSOLD) : false

int exGenericDeterioration = (exMomentumDeteriorates ? 1 : 0) + (exRsiDeteriorates ? 1 : 0) + (exParticipationState == EX_PSE_CONTRARY ? 1 : 0)
int exDestinationDeterioration = (exMomentumDeteriorates ? 1 : 0) + (exRsiDeteriorates ? 1 : 0) + ((exParticipationState == EX_PSE_WEAK or exParticipationState == EX_PSE_CONTRARY) ? 1 : 0)
int exCurrentStrength = not exCoherentMap ? EX_STRENGTH_NORMAL :
     exLocation == EX_LOC_DESTINATION_NEAR and exDestinationDeterioration >= 2 ? EX_STRENGTH_REACTION_RISK :
     exGenericDeterioration >= 2 ? EX_STRENGTH_EXHAUSTED :
     exGenericDeterioration == 1 ? EX_STRENGTH_FADING : EX_STRENGTH_NORMAL

var int exReadiness = EX_READY_WAIT
var int exDir = 0
var int exStrength = EX_STRENGTH_NORMAL
bool exConfirmEvent = false

if barstate.isconfirmed
    int prevReadiness = exReadiness
    int prevDir = exDir
    int nextReadiness = prevReadiness
    int nextDir = prevDir
    int nextStrength = exCoherentMap ? exCurrentStrength : EX_STRENGTH_NORMAL

    if not exCoherentMap
        nextReadiness := EX_READY_WAIT
        nextDir := 0
        nextStrength := EX_STRENGTH_NORMAL
    else if prevDir != 0 and prevDir != mapDir
        nextReadiness := EX_READY_WAIT
        nextDir := 0
    else if prevReadiness == EX_READY_WAIT
        if exRelevantLocation and not exMomentumStronglyOpposes
            nextReadiness := EX_READY_PREP
            nextDir := mapDir
        else
            nextReadiness := EX_READY_WAIT
            nextDir := 0
    else if prevReadiness == EX_READY_PREP
        if not exRelevantLocation or exMomentumStronglyOpposes or exParticipationState == EX_PSE_CONTRARY
            nextReadiness := EX_READY_WAIT
            nextDir := 0
        else if exMomentumAligned and exRsiSupportive
            nextReadiness := EX_READY_ARMED
            nextDir := mapDir
        else
            nextReadiness := EX_READY_PREP
            nextDir := mapDir
    else if prevReadiness == EX_READY_ARMED
        if not exRelevantLocation or exMomentumStronglyOpposes or exRsiOpposes or exParticipationState == EX_PSE_CONTRARY
            nextReadiness := EX_READY_WAIT
            nextDir := 0
        else if exMomentumAligned and exRsiSupportive and exParticipationState == EX_PSE_CONFIRM
            nextReadiness := EX_READY_CONFIRMED
            nextDir := mapDir
            exConfirmEvent := true
        else
            nextReadiness := EX_READY_ARMED
            nextDir := mapDir
    else if prevReadiness == EX_READY_CONFIRMED
        nextReadiness := EX_READY_ALIGNED
        nextDir := mapDir
    else if prevReadiness == EX_READY_ALIGNED
        if exMomentumStronglyOpposes and exRsiOpposes
            nextReadiness := EX_READY_WAIT
            nextDir := 0
        else
            nextReadiness := EX_READY_ALIGNED
            nextDir := mapDir

    exReadiness := nextReadiness
    exDir := nextDir
    exStrength := nextStrength

// ---------------------------------------------------------------------------
// OPERATOR_READINESS_V1 — embedded projection
// ---------------------------------------------------------------------------
bool exExecutionHorizonEnabled = not monthlyMacroOnly
bool exFrozenActive = exExecutionHorizonEnabled and exReadiness != EX_READY_WAIT and exDir != 0
bool exTrendActive = exExecutionHorizonEnabled and exTrendReadiness != EX_READY_WAIT and exTrendReadinessDir != 0
bool exRangeActive = exExecutionHorizonEnabled and exRangeReadiness != EX_READY_WAIT and exRangeReadinessDir != 0

int exOperatorDirCandidate = 0
bool exOperatorConflict = false
if exFrozenActive
    exOperatorDirCandidate := exDir
if exTrendActive
    if exOperatorDirCandidate != 0 and exTrendReadinessDir != exOperatorDirCandidate
        exOperatorConflict := true
    else if exOperatorDirCandidate == 0
        exOperatorDirCandidate := exTrendReadinessDir
if exRangeActive
    if exOperatorDirCandidate != 0 and exRangeReadinessDir != exOperatorDirCandidate
        exOperatorConflict := true
    else if exOperatorDirCandidate == 0
        exOperatorDirCandidate := exRangeReadinessDir

int exFrozenUrgency = exFrozenActive ? f_ex_ready_urgency(exReadiness) : 0
int exTrendUrgency = exTrendActive ? f_ex_ready_urgency(exTrendReadiness) : 0
int exRangeUrgency = exRangeActive ? f_ex_ready_urgency(exRangeReadiness) : 0
int exOperatorMaxUrgency = math.max(exFrozenUrgency, math.max(exTrendUrgency, exRangeUrgency))

bool exSelectFrozen = exFrozenActive and exFrozenUrgency == exOperatorMaxUrgency
bool exSelectTrend = exTrendActive and exTrendUrgency == exOperatorMaxUrgency
bool exSelectRange = exRangeActive and exRangeUrgency == exOperatorMaxUrgency
int exSelectedPathCount = (exSelectFrozen ? 1 : 0) + (exSelectTrend ? 1 : 0) + (exSelectRange ? 1 : 0)

int exOperatorReadiness = EX_OP_READY_WAIT
int exOperatorDir = 0
int exOperatorSourcePath = EX_PATH_NONE
int exOperatorOppKind = EX_OPP_NONE

if exOperatorConflict
    exOperatorReadiness := EX_OP_READY_CONFLICT
else if exOperatorDirCandidate != 0 and exOperatorMaxUrgency > 0
    exOperatorDir := exOperatorDirCandidate
    exOperatorReadiness := exSelectFrozen ? exReadiness : exSelectTrend ? exTrendReadiness : exRangeReadiness
    exOperatorSourcePath := exSelectedPathCount > 1 ? EX_PATH_MULTI : exSelectFrozen ? EX_PATH_FROZEN_0_1 : exSelectTrend ? EX_PATH_TREND_V2 : EX_PATH_RANGE_ANY1
    exOperatorOppKind := exSelectTrend and not exSelectRange ? exTrendOppKind :
         exSelectRange and not exSelectTrend ? EX_OPP_RANGE_ROTATION : EX_OPP_NONE

bool exOperatorConfirmEvent = barstate.isconfirmed and not exOperatorConflict and exOperatorDir != 0 and
     ((exConfirmEvent and exDir == exOperatorDir) or
      (exTrendConfirmEvent and exTrendReadinessDir == exOperatorDir) or
      (exRangeConfirmEvent and exRangeReadinessDir == exOperatorDir))

bool exOperatorArmedEntered = barstate.isconfirmed and exOperatorReadiness == EX_OP_READY_ARMED and
     (nz(exOperatorReadiness[1], EX_OP_READY_WAIT) != EX_OP_READY_ARMED or nz(exOperatorDir[1], 0) != exOperatorDir)

bool exAnticipatedTfSupported = timeframe.period == "15" or timeframe.period == "60" or timeframe.period == "240" or timeframe.period == "D" or timeframe.period == "3D"
bool exAnticipatedKindSupported = exTrendOppKind == EX_OPP_BREAKOUT_EXPANSION or exTrendOppKind == EX_OPP_REACCELERATION
bool exAnticipatedPosture = responseProfile == "ANTECIPADO" and exAnticipatedTfSupported and exOperatorSourcePath == EX_PATH_TREND_V2 and exAnticipatedKindSupported and exOperatorReadiness == EX_OP_READY_ARMED and not exOperatorConflict
bool exAnticipatedEvent = exAnticipatedPosture and exOperatorArmedEntered

// ---------------------------------------------------------------------------
// Thesis Management V1.1 — embedded projection
// ---------------------------------------------------------------------------
bool exConfirmingFrozen = exOperatorConfirmEvent and exConfirmEvent and exDir == exOperatorDir
bool exConfirmingTrend = exOperatorConfirmEvent and exTrendConfirmEvent and exTrendReadinessDir == exOperatorDir
bool exConfirmingRange = exOperatorConfirmEvent and exRangeConfirmEvent and exRangeReadinessDir == exOperatorDir
int exConfirmingSourceCount = (exConfirmingFrozen ? 1 : 0) + (exConfirmingTrend ? 1 : 0) + (exConfirmingRange ? 1 : 0)

var bool exManagementActive = false
var int exManagementState = EX_MGMT_NONE
var int exManagementDir = 0
var int exManagementSourcePath = EX_PATH_NONE
var int exManagementOppKind = EX_OPP_NONE
var int exManagementConfirmBar = na
var float exManagementConfirmClose = na
var float exManagementTarget = na
var float exManagementInvalidation = na
var int exManagementCapability = EX_CAP_NONE

bool exManagementNewThesis = false
bool exManagementCompletedEvent = false
bool exManagementInvalidatedEvent = false
bool exManagementAmbiguousEvent = false
float exManagementPathProgress = na
float exManagementTargetRoomAtr = na
float exManagementInvalidationBufferAtr = na
int exManagementStrength = EX_STRENGTH_NORMAL

if barstate.isconfirmed
    if exOperatorConfirmEvent and exOperatorDir != 0 and exConfirmingSourceCount > 0
        float mergedTarget = na
        float mergedInvalidation = na
        bool targetConflict = false
        bool invalidationConflict = false

        float frozenTarget = exConfirmingFrozen ? destination1 : na
        float frozenInvalidation = exConfirmingFrozen ? invalidation : na
        float trendTarget = exConfirmingTrend ? destination1 : na
        float trendInvalidation = exConfirmingTrend ? invalidation : na
        float rangeTarget = exConfirmingRange ? (exOperatorDir == 1 ? exRangeOppHigh - exRangeOppEdge : exRangeOppLow + exRangeOppEdge) : na
        float rangeInvalidation = exConfirmingRange ? (exOperatorDir == 1 ? exRangeOppLow : exRangeOppHigh) : na

        if f_ex_target_usable(exOperatorDir, close, frozenTarget)
            mergedTarget := frozenTarget
        if f_ex_target_usable(exOperatorDir, close, trendTarget)
            if na(mergedTarget)
                mergedTarget := trendTarget
            else if not f_ex_same_level(mergedTarget, trendTarget)
                targetConflict := true
        if f_ex_target_usable(exOperatorDir, close, rangeTarget)
            if na(mergedTarget)
                mergedTarget := rangeTarget
            else if not f_ex_same_level(mergedTarget, rangeTarget)
                targetConflict := true

        if f_ex_invalidation_usable(exOperatorDir, close, frozenInvalidation)
            mergedInvalidation := frozenInvalidation
        if f_ex_invalidation_usable(exOperatorDir, close, trendInvalidation)
            if na(mergedInvalidation)
                mergedInvalidation := trendInvalidation
            else if not f_ex_same_level(mergedInvalidation, trendInvalidation)
                invalidationConflict := true
        if f_ex_invalidation_usable(exOperatorDir, close, rangeInvalidation)
            if na(mergedInvalidation)
                mergedInvalidation := rangeInvalidation
            else if not f_ex_same_level(mergedInvalidation, rangeInvalidation)
                invalidationConflict := true

        if targetConflict
            mergedTarget := na
        if invalidationConflict
            mergedInvalidation := na

        exManagementActive := true
        exManagementState := EX_MGMT_CONTINUATION
        exManagementDir := exOperatorDir
        exManagementSourcePath := exConfirmingSourceCount > 1 ? EX_PATH_MULTI : exConfirmingFrozen ? EX_PATH_FROZEN_0_1 : exConfirmingTrend ? EX_PATH_TREND_V2 : EX_PATH_RANGE_ANY1
        exManagementOppKind := exConfirmingSourceCount > 1 ? EX_OPP_NONE : exConfirmingTrend ? exTrendOppKind : exConfirmingRange ? EX_OPP_RANGE_ROTATION : EX_OPP_NONE
        exManagementConfirmBar := bar_index
        exManagementConfirmClose := close
        exManagementTarget := mergedTarget
        exManagementInvalidation := mergedInvalidation
        exManagementCapability := not na(mergedTarget) and not na(mergedInvalidation) ? EX_CAP_FULL :
             not na(mergedInvalidation) ? EX_CAP_INVALIDATION_ONLY :
             not na(mergedTarget) ? EX_CAP_TARGET_ONLY : EX_CAP_NONE
        exManagementNewThesis := true

    if exManagementActive and exManagementDir != 0
        bool targetHit = not na(exManagementTarget) and (exManagementDir == 1 ? high >= exManagementTarget : low <= exManagementTarget)
        bool invalidated = not na(exManagementInvalidation) and (exManagementDir == 1 ? close < exManagementInvalidation : close > exManagementInvalidation)

        exManagementTargetRoomAtr := not na(exManagementTarget) and atr > 0 ? exManagementDir * (exManagementTarget - close) / atr : na
        exManagementInvalidationBufferAtr := not na(exManagementInvalidation) and atr > 0 ? exManagementDir * (close - exManagementInvalidation) / atr : na
        bool targetNear = not targetHit and not na(exManagementTargetRoomAtr) and exManagementTargetRoomAtr >= 0 and exManagementTargetRoomAtr <= EX_MGMT_TARGET_NEAR_ATR
        bool invalidationNear = not invalidated and not na(exManagementInvalidationBufferAtr) and exManagementInvalidationBufferAtr >= 0 and exManagementInvalidationBufferAtr <= EX_MGMT_INVALID_WARN_ATR

        float initialTargetDistance = not na(exManagementTarget) ? exManagementDir * (exManagementTarget - exManagementConfirmClose) : na
        exManagementPathProgress := not na(initialTargetDistance) and initialTargetDistance > 0 ? exManagementDir * (close - exManagementConfirmClose) / initialTargetDistance : na

        int managementPse = f_ex_pse_state_dir(exManagementDir, exPseReady, exRelativeVolume, exPressureProxy)
        exManagementStrength := f_ex_strength_for_dir(exManagementDir, targetNear, exMteState, exRsiState, managementPse)

        if targetHit and invalidated
            exManagementState := EX_MGMT_AMBIGUOUS
            exManagementAmbiguousEvent := true
            exManagementActive := false
        else if targetHit
            exManagementState := EX_MGMT_COMPLETED
            exManagementCompletedEvent := true
            exManagementActive := false
        else if invalidated
            exManagementState := EX_MGMT_INVALIDATED
            exManagementInvalidatedEvent := true
            exManagementActive := false
        else if invalidationNear
            exManagementState := EX_MGMT_PROTECT
        else if (targetNear and exManagementStrength == EX_STRENGTH_REACTION_RISK) or
             (not na(exManagementPathProgress) and exManagementPathProgress >= 0.50 and
              (exManagementStrength == EX_STRENGTH_FADING or exManagementStrength == EX_STRENGTH_EXHAUSTED or exManagementStrength == EX_STRENGTH_REACTION_RISK))
            exManagementState := EX_MGMT_REALIZATION_RISK
        else if exManagementStrength == EX_STRENGTH_EXHAUSTED
            exManagementState := EX_MGMT_PROTECT
        else
            exManagementState := EX_MGMT_CONTINUATION
    else if not exManagementNewThesis and exManagementState != EX_MGMT_NONE
        exManagementState := EX_MGMT_NONE
        exManagementDir := 0
        exManagementSourcePath := EX_PATH_NONE
        exManagementOppKind := EX_OPP_NONE
        exManagementConfirmBar := na
        exManagementConfirmClose := na
        exManagementTarget := na
        exManagementInvalidation := na
        exManagementCapability := EX_CAP_NONE
        exManagementPathProgress := na
        exManagementTargetRoomAtr := na
        exManagementInvalidationBufferAtr := na
        exManagementStrength := EX_STRENGTH_NORMAL

string executionTxt = f_ex_operator_txt(exOperatorReadiness, exOperatorDir)
string strengthTxt = f_ex_strength_txt(exStrength)
string opportunityTxt = exOperatorOppKind != EX_OPP_NONE ? f_ex_opp_txt(exOperatorOppKind) :
     exOperatorSourcePath == EX_PATH_FROZEN_0_1 ? (exLocation == EX_LOC_RETEST or exLocation == EX_LOC_RECLAIM ? "RETESTE / RECLAIM" : "CORREÇÃO") : "—"
string managementTxt = f_ex_management_txt(exManagementState)

// ---------------------------------------------------------------------------
// Historical engineering telemetry — Data Window only
// ---------------------------------------------------------------------------
// These counters validate map behavior on the chart's loaded history. They are
// engineering diagnostics, not predictive probabilities and not trade signals.
var int diagTrackedKey = na
var int diagTrackedDir = 0
var float diagTrackedDestination = na
var int diagZoneTouchBar = na
var bool diagZoneTouched = false
var bool diagDestinationHit = false
var bool diagInvalidated = false
var bool diagOutcomeResolved = false

var int diagTheses = 0
var int diagZoneTouches = 0
var int diagDestinationHits = 0
var int diagInvalidations = 0
var int diagZoneToDestination = 0
var int diagZoneToInvalidation = 0
var int diagAmbiguousOutcomes = 0
var int diagSupersededAfterTouch = 0
var int diagOutcomeBarsSum = 0
var int diagOutcomeBarsCount = 0

bool diagNewThesis = barstate.isconfirmed and correctionReady and not na(impulseKey) and impulseKey != diagTrackedKey
if diagNewThesis
    if diagZoneTouched and not diagOutcomeResolved
        diagSupersededAfterTouch += 1
    diagTrackedKey := impulseKey
    diagTrackedDir := mapDir
    diagTrackedDestination := na
    diagZoneTouchBar := na
    diagZoneTouched := false
    diagDestinationHit := false
    diagInvalidated := false
    diagOutcomeResolved := false
    diagTheses += 1

bool diagZoneTouchNow = barstate.isconfirmed and correctionActive and not diagZoneTouched and high >= primaryBottom and low <= primaryTop

// Historical bars are not the chart's last bar, so the normal live acceptance
// calculation is intentionally absent there. Recompute it only on the first
// correction-zone touch so historical confluence-at-touch remains faithful
// without paying a 240-bar scan on every historical candle.
float diagTouchVwap = na
float diagTouchVNode = na
int diagTouchAcceptanceBars = 0
if diagZoneTouchNow
    [touchVwap, touchVNode, touchBars] = f_impulse_acceptance(impulseStartBar, impulseEndBar, impulseLow, impulseHigh)
    diagTouchVwap := touchVwap
    diagTouchVNode := touchVNode
    diagTouchAcceptanceBars := touchBars

if diagZoneTouchNow
    diagZoneTouched := true
    diagZoneTouchBar := bar_index
    // Freeze the target that was actionable entering the touch candle only when
    // it is still a valid post-correction destination. A LIVE correction zone
    // can move enough that yesterday's nearest liquidity is now inside/behind
    // the zone; counting that stale level as a future destination corrupts the
    // historical zone-outcome audit.
    bool prevTargetBeyondZone = not na(destination1[1]) and
         (mapDir == 1 ? destination1[1] > primaryTop : mapDir == -1 ? destination1[1] < primaryBottom : false)
    bool currentTargetBeyondZone = not na(destination1) and
         (mapDir == 1 ? destination1 > primaryTop : mapDir == -1 ? destination1 < primaryBottom : false)
    bool prevTargetUsable = mapDir[1] == mapDir and prevTargetBeyondZone
    diagTrackedDestination := prevTargetUsable ? destination1[1] : currentTargetBeyondZone ? destination1 : na
    diagZoneTouches += 1

bool diagDestinationCondition = barstate.isconfirmed and diagZoneTouched and not diagDestinationHit and not na(diagTrackedDestination) and
     ((diagTrackedDir == 1 and high >= diagTrackedDestination) or (diagTrackedDir == -1 and low <= diagTrackedDestination))
bool diagInvalidationCondition = barstate.isconfirmed and diagZoneTouched and thesisInvalidated and not diagInvalidated

// OHLC usually does not reveal intrabar ordering. One safe exception exists:
// if a valid target lies beyond the correction zone and the candle opens in or
// behind that zone, reaching the target necessarily happens after the zone was
// touched. Keep genuinely unordered same-bar outcomes ambiguous.
bool diagSameBarAsTouch = diagZoneTouched and not na(diagZoneTouchBar) and bar_index == diagZoneTouchBar
bool diagZoneBeforeTargetInferable = diagSameBarAsTouch and diagDestinationCondition and not diagInvalidationCondition and
     ((diagTrackedDir == 1 and diagTrackedDestination > primaryTop and open <= primaryTop) or
      (diagTrackedDir == -1 and diagTrackedDestination < primaryBottom and open >= primaryBottom))
bool diagAmbiguousNow = not diagOutcomeResolved and
     ((diagSameBarAsTouch and (diagDestinationCondition or diagInvalidationCondition) and not diagZoneBeforeTargetInferable) or
      (diagDestinationCondition and diagInvalidationCondition))

bool diagDestinationResolvedNow = diagDestinationCondition and not diagAmbiguousNow and not diagOutcomeResolved
bool diagInvalidationResolvedNow = diagInvalidationCondition and not diagAmbiguousNow and not diagOutcomeResolved

if diagAmbiguousNow
    diagAmbiguousOutcomes += 1
    diagOutcomeResolved := true

if diagDestinationCondition
    diagDestinationHit := true
    diagDestinationHits += 1
    if diagDestinationResolvedNow
        diagZoneToDestination += 1
        diagOutcomeResolved := true
        diagOutcomeBarsSum += bar_index - diagZoneTouchBar
        diagOutcomeBarsCount += 1

if diagInvalidationCondition
    diagInvalidated := true
    diagInvalidations += 1
    if diagInvalidationResolvedNow
        diagZoneToInvalidation += 1
        diagOutcomeResolved := true
        diagOutcomeBarsSum += bar_index - diagZoneTouchBar
        diagOutcomeBarsCount += 1

float diagResolvedAfterZone = diagZoneToDestination + diagZoneToInvalidation
float diagOpenAfterZone = math.max(0, diagZoneTouches - diagResolvedAfterZone - diagAmbiguousOutcomes - diagSupersededAfterTouch)
float diagZoneTouchPct = diagTheses > 0 ? 100.0 * diagZoneTouches / diagTheses : na
float diagAvgBarsToOutcome = diagOutcomeBarsCount > 0 ? 1.0 * diagOutcomeBarsSum / diagOutcomeBarsCount : na
float diagZoneReactionPct = diagResolvedAfterZone > 0 ? 100.0 * diagZoneToDestination / diagResolvedAfterZone : na

bool inT1 = correctionActive and close <= t1Top and close >= t1Bottom
bool inPrimary = correctionActive and close <= primaryTop and close >= primaryBottom
bool inT3 = correctionActive and close <= t3Top and close >= t3Bottom

float zoneTol = atr * 0.15
bool fibCoreOverlap = correctionReady and primaryTop >= fibT2Bottom and primaryBottom <= fibT2Top

float acceptanceEvidenceVwap = diagZoneTouchNow ? diagTouchVwap : impulseVwap
float acceptanceEvidenceVNode = diagZoneTouchNow ? diagTouchVNode : impulseVNode
int acceptanceEvidenceBars = diagZoneTouchNow ? diagTouchAcceptanceBars : acceptanceBars
bool acceptanceEvidenceReady = acceptanceEvidenceBars >= 8 and not na(acceptanceEvidenceVwap)

int correctionConfluence = correctionActive ? 1 : 0
correctionConfluence += fibCoreOverlap ? 1 : 0
correctionConfluence += f_in_zone(emaMid, primaryTop, primaryBottom, zoneTol) ? 1 : 0
correctionConfluence += f_in_zone(lastBreakLevel, primaryTop, primaryBottom, zoneTol) ? 1 : 0
float reactionLiquidityLevel = relevantReclaimEvt ? relevantReclaimLevel : (mapDir == 1 ? liqBelow : liqAbove)
correctionConfluence += f_in_zone(reactionLiquidityLevel, primaryTop, primaryBottom, zoneTol) ? 1 : 0
correctionConfluence += acceptanceEvidenceReady and (f_in_zone(acceptanceEvidenceVwap, primaryTop, primaryBottom, zoneTol) or f_in_zone(acceptanceEvidenceVNode, primaryTop, primaryBottom, zoneTol)) ? 1 : 0

// ---------------------------------------------------------------------------
// Phase classifier
// ---------------------------------------------------------------------------
string phaseTxt = "MAPEANDO"

if mapDir == 1 and correctionActive
    phaseTxt := close > impulseHigh ? "ROMPIMENTO / IMPULSO" :
         retestUp ? "RETESTE" :
         inT1 or inPrimary or inT3 ? "CORREÇÃO" :
         close < t3Bottom and close > invalidation ? "CORREÇÃO PROFUNDA" :
         close < impulseHigh ? "PULLBACK" : "IMPULSO"

if mapDir == -1 and correctionActive
    phaseTxt := close < impulseLow ? "ROMPIMENTO / IMPULSO" :
         retestDown ? "RETESTE" :
         inT1 or inPrimary or inT3 ? "CORREÇÃO" :
         close > t3Top and close < invalidation ? "CORREÇÃO PROFUNDA" :
         close > impulseLow ? "PULLBACK" : "IMPULSO"

if mapDir == 0
    phaseTxt := regimeStructureConflict ? "TRANSIÇÃO ESTRUTURAL" : "TRANSIÇÃO"

if correctionActive and relevantReclaimEvt
    phaseTxt := "SWEEP / RECLAIM"

if correctionActive and (nearInvalidation or invalidationBrokenNow)
    phaseTxt := "TESTE DE INVALIDAÇÃO"

if thesisInvalidated
    phaseTxt := "TESE INVALIDADA"

if fakeoutUpEvt or fakeoutDownEvt
    phaseTxt := "FALSO ROMPIMENTO"

// ---------------------------------------------------------------------------
// Visual layer
// ---------------------------------------------------------------------------
color fastColor = color.rgb(0, 188, 212)
color midColor = color.rgb(255, 167, 38)
color slowColor = color.rgb(239, 83, 80)

plot(showMAs ? emaFast : na, "EMA 21", color=fastColor, linewidth=1)
plot(showMAs ? emaMid : na, "EMA 50", color=midColor, linewidth=2)
plot(showMAs ? emaSlow : na, "EMA 200", color=slowColor, linewidth=3)

plotshape(detailed and bosUp, title="BOS Up", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), text="B↑", textcolor=color.white, size=size.tiny, display=display.pane)
plotshape(detailed and chochUp, title="CHoCH Up", style=shape.labelup, location=location.belowbar, color=color.new(color.teal, 0), text="CH↑", textcolor=color.white, size=size.tiny, display=display.pane)
plotshape(detailed and bosDown, title="BOS Down", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="B↓", textcolor=color.white, size=size.tiny, display=display.pane)
plotshape(detailed and chochDown, title="CHoCH Down", style=shape.labeldown, location=location.abovebar, color=color.new(color.orange, 0), text="CH↓", textcolor=color.white, size=size.tiny, display=display.pane)
plotshape(detailed and retestUp, title="Retest Up", style=shape.circle, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny, display=display.pane)
plotshape(detailed and retestDown, title="Retest Down", style=shape.circle, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, display=display.pane)
plotshape(detailed and fakeoutUpEvt, title="Failed Break Up", style=shape.labeldown, location=location.abovebar, color=color.new(color.orange, 0), text="FX↑", textcolor=color.white, size=size.tiny, display=display.pane)
plotshape(detailed and fakeoutDownEvt, title="Failed Break Down", style=shape.labelup, location=location.belowbar, color=color.new(color.orange, 0), text="FX↓", textcolor=color.white, size=size.tiny, display=display.pane)

// Current-map objects only: no historical box clutter.
var box t1Box = na
var box t2Box = na
var box t3Box = na
var line invalidLine = na
var line liqAboveLine = na
var line liqBelowLine = na

if barstate.islast
    bool showT1T3 = detailed and correctionActive
    bool showPrimary = correctionActive

    if showT1T3
        if na(t1Box)
            t1Box := box.new(impulseEndBar, t1Top, bar_index + 20, t1Bottom, xloc=xloc.bar_index, extend=extend.right, border_color=color.new(color.aqua, 55), bgcolor=color.new(color.aqua, 92))
        else
            box.set_left(t1Box, impulseEndBar)
            box.set_right(t1Box, bar_index + 20)
            box.set_top(t1Box, t1Top)
            box.set_bottom(t1Box, t1Bottom)

        if na(t3Box)
            t3Box := box.new(impulseEndBar, t3Top, bar_index + 20, t3Bottom, xloc=xloc.bar_index, extend=extend.right, border_color=color.new(color.red, 58), bgcolor=color.new(color.red, 93))
        else
            box.set_left(t3Box, impulseEndBar)
            box.set_right(t3Box, bar_index + 20)
            box.set_top(t3Box, t3Top)
            box.set_bottom(t3Box, t3Bottom)
    else
        if not na(t1Box)
            box.delete(t1Box)
            t1Box := na
        if not na(t3Box)
            box.delete(t3Box)
            t3Box := na

    if showPrimary
        if na(t2Box)
            t2Box := box.new(impulseEndBar, primaryTop, bar_index + 20, primaryBottom, xloc=xloc.bar_index, extend=extend.right, border_color=color.new(color.yellow, 30), bgcolor=color.new(color.yellow, 88))
        else
            box.set_left(t2Box, impulseEndBar)
            box.set_right(t2Box, bar_index + 20)
            box.set_top(t2Box, primaryTop)
            box.set_bottom(t2Box, primaryBottom)
    else
        if not na(t2Box)
            box.delete(t2Box)
            t2Box := na

    if correctionActive
        if na(invalidLine)
            invalidLine := line.new(impulseEndBar, invalidation, bar_index + 20, invalidation, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.red, 15), style=line.style_dashed, width=1)
        else
            line.set_xy1(invalidLine, impulseEndBar, invalidation)
            line.set_xy2(invalidLine, bar_index + 20, invalidation)
    else
        if not na(invalidLine)
            line.delete(invalidLine)
            invalidLine := na

    if not na(liqAbove)
        if na(liqAboveLine)
            liqAboveLine := line.new(math.max(liqAboveBar, bar_index - 5000), liqAbove, bar_index + 20, liqAbove, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.fuchsia, 25), style=line.style_dotted, width=1)
        else
            line.set_xy1(liqAboveLine, math.max(liqAboveBar, bar_index - 5000), liqAbove)
            line.set_xy2(liqAboveLine, bar_index + 20, liqAbove)
    else
        if not na(liqAboveLine)
            line.delete(liqAboveLine)
            liqAboveLine := na

    if not na(liqBelow)
        if na(liqBelowLine)
            liqBelowLine := line.new(math.max(liqBelowBar, bar_index - 5000), liqBelow, bar_index + 20, liqBelow, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.fuchsia, 25), style=line.style_dotted, width=1)
        else
            line.set_xy1(liqBelowLine, math.max(liqBelowBar, bar_index - 5000), liqBelow)
            line.set_xy2(liqBelowLine, bar_index + 20, liqBelow)
    else
        if not na(liqBelowLine)
            line.delete(liqBelowLine)
            liqBelowLine := na

